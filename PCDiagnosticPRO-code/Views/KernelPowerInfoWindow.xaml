<Window x:Class="PCDiagnosticPro.Views.KernelPowerInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kernel Power (ID 1) vs (ID 41)"
        Height="480" Width="520"
        MinHeight="400" MinWidth="440"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#060A12">

    <Window.Resources>
        <SolidColorBrush x:Key="CyberBg" Color="#060A12"/>
        <SolidColorBrush x:Key="CyberCardBg" Color="#0B1220"/>
        <SolidColorBrush x:Key="CyberBorder" Color="#2AA7FF"/>
        <SolidColorBrush x:Key="CyberText" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="CyberTextDim" Color="#8B949E"/>
        <SolidColorBrush x:Key="CyberRed" Color="#FF2B2B"/>
        <DropShadowEffect x:Key="CyberRedGlow" Color="#FF2B2B" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
        <DropShadowEffect x:Key="CyberShadow" Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Kernel Power (ID 1) vs (ID 41)"
                   FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource CyberText}"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <StackPanel>
                <Border Background="{StaticResource CyberCardBg}" BorderBrush="{StaticResource CyberBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12" Effect="{StaticResource CyberShadow}">
                    <StackPanel>
                        <TextBlock Text="Explication" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberBorder}" Margin="0,0,0,8"/>
                        <TextBlock Foreground="{StaticResource CyberText}" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                            <Run Text="• Kernel Power (ID 1) = Information : changement lié à l'alimentation (veille, sortie de veille, secteur/batterie, plan d'alimentation, transitions d'état)."/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource CyberText}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0">
                            <Run Text="• Kernel Power (ID 41) = Critique : arrêt brutal ou redémarrage non planifié."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CyberCardBg}" BorderBrush="{StaticResource CyberBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12" Effect="{StaticResource CyberShadow}">
                    <StackPanel>
                        <TextBlock Text="Tableau de référence" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberBorder}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID" FontWeight="SemiBold" Foreground="{StaticResource CyberTextDim}" Margin="0,0,16,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Gravité" FontWeight="SemiBold" Foreground="{StaticResource CyberTextDim}" Margin="0,0,16,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Signification" FontWeight="SemiBold" Foreground="{StaticResource CyberTextDim}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="1" Foreground="{StaticResource CyberText}" Margin="0,4,16,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Information" Foreground="{StaticResource CyberText}" Margin="0,4,16,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Changement lié à l'alimentation" Foreground="{StaticResource CyberText}" Margin="0,4,0,6" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="41" Foreground="{StaticResource CyberText}" Margin="0,4,16,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Critique" Foreground="{StaticResource CyberText}" Margin="0,4,16,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Arrêt brutal ou redémarrage non planifié" Foreground="{StaticResource CyberText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CyberCardBg}" BorderBrush="{StaticResource CyberBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Effect="{StaticResource CyberShadow}">
                    <TextBlock Foreground="{StaticResource CyberText}" FontSize="13" TextWrapping="Wrap" FontWeight="SemiBold">
                        <Run Text="Conclusion : Donc si tu vois ID 1, ce n'est normalement pas un crash."/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Fermer button with red glow on hover -->
        <Button Grid.Row="2" Content="Fermer" HorizontalAlignment="Right" Padding="24,10" FontSize="14" FontWeight="SemiBold"
                Background="{StaticResource CyberCardBg}" Foreground="{StaticResource CyberText}"
                BorderBrush="{StaticResource CyberBorder}" BorderThickness="1" Cursor="Hand"
                Click="Close_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource CyberRed}"/>
                                        <Setter TargetName="border" Property="Effect" Value="{StaticResource CyberRedGlow}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
