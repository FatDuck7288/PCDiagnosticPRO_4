<Window x:Class="PCDiagnosticPro.Views.ScanConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autorisation administrateur requise"
        Height="520" Width="600"
        MinHeight="420" MinWidth="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF0D1117">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFE6EDF3"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF8B949E"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FFFF4757"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#FF2ECC71"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFFFA502"/>
        <SolidColorBrush x:Key="BgMedium" Color="#FF161B22"/>
        <SolidColorBrush x:Key="BorderDark" Color="#FF30363D"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Autorisation administrateur requise" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Le scan demande des droits élevés pour certaines fonctionnalités."
                       FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Info blocks -->
        <StackPanel Grid.Row="1">
            <!-- Why admin is needed -->
            <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="0,0,0,8"
                    BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x1F321;" FontSize="22" VerticalAlignment="Top" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Capteurs matériels (température CPU/GPU/MB)" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Nécessite les droits administrateur pour accéder aux capteurs hardware via LibreHardwareMonitor."
                                   FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Warning about Defender -->
            <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="0,0,0,8"
                    BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x26A0;" FontSize="22" VerticalAlignment="Top" Margin="0,0,12,0"
                               Foreground="{StaticResource AccentYellow}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Alertes Windows Security possibles" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource AccentYellow}"/>
                        <TextBlock Text="Windows peut afficher des alertes de sécurité (Accès contrôlé aux dossiers). Cela est normal pour les outils de diagnostic matériel."
                                   FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Guarantee: no writes to protected folders -->
            <Border Background="{StaticResource BgMedium}" CornerRadius="8" Padding="14" Margin="0,0,0,8"
                    BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x2705;" FontSize="22" VerticalAlignment="Top" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Aucune écriture dans vos dossiers protégés" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource AccentGreen}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Toutes les données sont stockées dans %LOCALAPPDATA%\PCDiagnosticPro. Aucun fichier ne sera écrit dans Documents, Images ou OneDrive."/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Separator -->
        <Border Grid.Row="2" Height="1" Background="{StaticResource BorderDark}" Margin="0,8,0,12"/>

        <!-- Action buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Annuler" Width="90" Height="34" Margin="0,0,8,0"
                    Background="Transparent" Foreground="{StaticResource TextPrimary}"
                    BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand"
                    Click="Cancel_Click"/>

            <Button Grid.Column="2" Content="Mode limité" Width="120" Height="34" Margin="0,0,8,0"
                    Background="{StaticResource BgMedium}" Foreground="{StaticResource AccentYellow}"
                    BorderBrush="{StaticResource AccentYellow}" BorderThickness="1" Cursor="Hand"
                    ToolTip="Continuer sans températures matérielles"
                    Click="LimitedMode_Click"/>

            <Button Grid.Column="3" Content="Continuer (UAC)" Width="140" Height="34"
                    Background="{StaticResource AccentRed}" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                    ToolTip="Relancer en mode administrateur"
                    Click="ContinueUAC_Click"/>
        </Grid>
    </Grid>
</Window>
