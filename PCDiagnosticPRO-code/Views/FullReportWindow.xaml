<Window x:Class="PCDiagnosticPro.Views.FullReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PCDiagnosticPro.Views"
        mc:Ignorable="d"
        Title="Rapport intégrale"
        Height="700" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Header: titre + stats + toggle -->
        <Border Grid.Row="0" Background="#161B22" Padding="20,14" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RAPPORT INTÉGRALE" FontSize="18" FontWeight="Bold" Foreground="#E6EDF3" VerticalAlignment="Center"/>
                    <TextBlock Margin="24,0,0,0" VerticalAlignment="Center" Foreground="#8B949E" FontSize="12">
                        <Run Text="Run: "/>
                        <Run Text="{Binding RunId}"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding ScanDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding Status}"/>
                    </TextBlock>
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#8B949E" FontSize="11">
                        <Run Text="Collecte: "/>
                        <Run Text="{Binding CoveragePercent, StringFormat='{}{0:F0}'}"/>
                        <Run Text="% — Fiabilité: "/>
                        <Run Text="{Binding ReliabilityPercent, StringFormat='{}{0:F0}'}"/>
                        <Run Text="% — Actionabilité: "/>
                        <Run Text="{Binding ActionabilityPercent, StringFormat='{}{0:F0}'}"/>
                        <Run Text="%"/>
                    </TextBlock>
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#6B8" FontSize="10" FontFamily="Consolas"
                               Text="{Binding UiCoverageDisplay}"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" Content="Synthèse" IsChecked="{Binding IsSummaryMode}" 
                              Foreground="#E6EDF3" Background="#21262D" Padding="12,6" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <local:FullReportView Grid.Row="1" x:Name="ReportView"/>
    </Grid>
</Window>
