<Window x:Class="PCDiagnosticPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PCDiagnosticPro.ViewModels"
        xmlns:conv="clr-namespace:PCDiagnosticPro.Converters"
        xmlns:ctrl="clr-namespace:PCDiagnosticPro.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="PC Diagnostic Pro" 
        Height="800" Width="1100"
        MinHeight="700" MinWidth="900"
        Background="{StaticResource BackgroundDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:GradeToColorConverter x:Key="GradeToColor"/>
        <conv:GradeMatchOpacityConverter x:Key="GradeMatchOpacity"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:ProgressToBlurConverter x:Key="ProgressToBlur"/>
        <conv:ProgressToOpacityConverter x:Key="ProgressToOpacity"/>
        <conv:ProgressToArcConverter x:Key="ProgressToArc"/>
        <conv:HealthSeverityToColorConverter x:Key="SeverityToColor"/>
        <conv:HealthSeverityToIconConverter x:Key="SeverityToIcon"/>
        <conv:ScoreToHealthColorConverter x:Key="ScoreToHealthColor"/>
        <conv:HealthSeverityToAlertVisibilityConverter x:Key="SeverityToAlertVisibility"/>
        <conv:HexToSolidColorBrushConverter x:Key="HexToColorBrush"/>
        <conv:KernelPowerInfoButtonVisibilityConverter x:Key="KernelPowerInfoButtonVisibility"/>
        <conv:ScoreToPerformanceBrushConverter x:Key="ScoreToPerformanceBrush"/>
        <conv:ScoreToBarWidthConverter x:Key="ScoreToBarWidth"/>
        <conv:PerformanceScoreToDisplayConverter x:Key="PerformanceScoreToDisplay"/>
        <conv:PerformanceHeaderAvailabilityToVisibilityConverter x:Key="PerformanceHeaderAvailabilityToVisibility"/>
        <conv:IntGreaterThanZeroToVisibilityConverter x:Key="IntGreaterThanZeroToVisibility"/>
        <conv:CollectionNotEmptyToVisibilityConverter x:Key="CollectionNotEmptyToVisibility"/>
        <conv:HealthDomainToVisibilityConverter x:Key="HealthDomainToVisibility"/>
        <sys:Double x:Key="CompactPanelHeight">140</sys:Double>
        
        <!-- Style pour texte sélectionnable et copiable dans les tableaux -->
        <Style x:Key="SelectableTextStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Copier" Command="ApplicationCommands.Copy"/>
                        <MenuItem Header="Tout sélectionner" Command="ApplicationCommands.SelectAll"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SelectableTextSecondaryStyle" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- BARRE LATERALE GAUCHE -->
        <Border Grid.Column="0" Background="{StaticResource BackgroundMediumBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Top" Margin="0,20,0,0">
                
                <!-- Logo -->
                <Border Width="50" Height="50" CornerRadius="25" 
                        Background="{StaticResource AccentRedBrush}" Margin="0,0,0,30"
                        HorizontalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" 
                               VerticalAlignment="Center" Foreground="White"/>
                </Border>

                <!-- Bouton Accueil -->
                <Button Width="50" Height="50" Margin="0,5" Padding="0" 
                        ToolTip="{Binding NavHomeTooltip}" Cursor="Hand"
                        Command="{Binding NavigateToScannerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}">
                            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScannerView}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="🏠" FontSize="20"/>
                </Button>

                <!-- Bouton Scan -->
                <Button Width="50" Height="50" Margin="0,5" Padding="0" 
                        ToolTip="{Binding NavScanTooltip}" Cursor="Hand"
                        Command="{Binding NavigateToHealthcheckCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}">
                            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHealthcheckView}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="🔍" FontSize="20"/>
                </Button>
                
                <!-- Bouton Rapports -->
                <Button Width="50" Height="50" Margin="0,5" Padding="0" 
                        ToolTip="{Binding NavReportsTooltip}" Cursor="Hand"
                        Command="{Binding NavigateToResultsCommand}"
                        IsEnabled="{Binding HasAnyScan}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}">
                            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                            <Setter Property="Opacity" Value="0.4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsResultsView}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasAnyScan}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="📊" FontSize="20"/>
                </Button>
                
                <!-- Bouton Parametres -->
                <Button Width="50" Height="50" Margin="0,5" Padding="0" 
                        ToolTip="{Binding NavSettingsTooltip}" Cursor="Hand"
                        Command="{Binding NavigateToSettingsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}">
                            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="⚙️" FontSize="20"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ZONE PRINCIPALE — ClipToBounds=False pour permettre le glow des éléments -->
        <Grid Grid.Column="1" Margin="30" ClipToBounds="False">
            
            <!-- VUE HOME -->
            <Grid Visibility="{Binding IsScannerView, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,40" HorizontalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding HomeTitle}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding HomeTitle}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{StaticResource AccentRed}" BlurRadius="30" ShadowDepth="0" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding HomeSubtitle}" FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"
                               TextAlignment="Center"/>
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="2">
                    <!-- Carte Scan -->
                    <Border Margin="15" Cursor="Hand" Style="{StaticResource CardStyle}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToHealthcheckCommand}"/>
                        </Border.InputBindings>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                            <TextBlock Text="⚡" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="{Binding HomeScanTitle}" FontSize="28" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <TextBlock Text="{Binding HomeScanAction}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentRedBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding HomeScanDescription}" 
                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Carte Chat -->
                    <Border Margin="15" Cursor="Hand" Style="{StaticResource CardStyle}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToChatCommand}"/>
                        </Border.InputBindings>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                            <TextBlock Text="🤖" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="{Binding HomeChatTitle}" FontSize="28" FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <TextBlock Text="{Binding HomeChatAction}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentRedBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding HomeChatDescription}" 
                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- VUE HEALTHCHECK — scrollbar à l'extrême droite de la fenêtre.
                 Margin="0,0,-30,0" annule le padding-right du parent (Margin="30") pour
                 que le scrollbar touche le bord droit du viewport.
                 VerticalScrollBarVisibility="Visible" réserve toujours l'espace → zéro reflow. -->
            <ScrollViewer Visibility="{Binding IsHealthcheckView, Converter={StaticResource BoolToVisibility}}"
                          Margin="0,0,-30,0"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True"
                          ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="400"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <!-- Colonne gauche : grille 3 lignes (scroll géré par le ScrollViewer parent). -->
                    <Grid Grid.Column="0" MinWidth="480" Margin="24,0,20,8" ClipToBounds="False">
                    <Grid.RowDefinitions>
                        <!-- FIX #3: Live feed élargi (150px) pour section active + progress bar + log -->
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                        <!-- MinHeight=540 : doit recevoir au moins 540px (RingRowContainer 500 + Margin 10*2 = 520) -->
                        <RowDefinition Height="*" MinHeight="540"/>
                    </Grid.RowDefinitions>

                    <!-- ROW 0: Live feed amélioré — Section active + progress bar + flux rapide -->
                    <Border Grid.Row="0" Background="#161B22" CornerRadius="12" Padding="12,8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Margin="0,0,0,12" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Titre + section active -->
                                <RowDefinition Height="Auto"/>  <!-- Progress bar -->
                                <RowDefinition Height="*"/>     <!-- Log défilant -->
                            </Grid.RowDefinitions>
                            
                            <!-- Ligne 0: Titre feed + Section en cours (toujours visible) -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{StaticResource AccentRedBrush}" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="📡 {0}">
                                            <Binding Path="LiveFeedLabel"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <!-- Section en cours: pulsation subtile pendant le scan -->
                                <TextBlock Grid.Column="1" Text="{Binding CurrentSectionDisplay}"
                                           FontSize="10" FontWeight="SemiBold" FontFamily="Consolas"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="250">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="SectionPulse">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.5" To="1" Duration="0:0:1"
                                                                                 AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="SectionPulse"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            
                            <!-- Ligne 1: Barre de progression linéaire (4px, slim, moderne, coins arrondis) -->
                            <ProgressBar Grid.Row="1" Height="4" Margin="0,0,0,6"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding SmoothProgressPercent, Mode=OneWay}"
                                         Foreground="{StaticResource AccentRedBrush}"
                                         Background="#30363D" BorderThickness="0"
                                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                                         AutomationProperties.Name="Scan progress">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                                            <Grid>
                                                <Border x:Name="PART_Track"/>
                                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                        Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            
                            <!-- Ligne 2: Live feed structuré avec colonnes alignées (style cyber / diagnostic tool) -->
                            <Grid Grid.Row="2" ClipToBounds="True">
                                <ListBox ItemsSource="{Binding FilteredLiveFeedItems}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="False"
                                         IsSynchronizedWithCurrentItem="True"
                                         Padding="0,2"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <!-- Slide-in + fade animation on new items -->
                                            <Style.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0" To="1" Duration="0:0:0.35">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Padding"
                                                                                From="0,-4,0,0" To="0,0,0,0" Duration="0:0:0.3">
                                                                <ThicknessAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </ThicknessAnimation.EasingFunction>
                                                            </ThicknessAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="2,2" BorderThickness="0,0,0,1" BorderBrush="#08FFFFFF">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Col 0: Timestamp -->
                                                        <ColumnDefinition Width="54"/>
                                                        <!-- Col 1: Badge [OK] [RUN] [ERR] -->
                                                        <ColumnDefinition Width="42"/>
                                                        <!-- Col 2: Section name -->
                                                        <ColumnDefinition Width="150"/>
                                                        <!-- Col 3: Separator -->
                                                        <ColumnDefinition Width="10"/>
                                                        <!-- Col 4: Detail message -->
                                                        <ColumnDefinition Width="*"/>
                                                        <!-- Col 5: Percent -->
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Timestamp gris discret -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Timestamp}"
                                                               FontFamily="Consolas" FontSize="9"
                                                               Foreground="#3D4450" VerticalAlignment="Center"/>

                                                    <!-- Badge coloré -->
                                                    <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Margin="1,1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Background="{Binding BadgeBackground}">
                                                        <TextBlock Text="{Binding Badge}"
                                                                   FontFamily="Consolas" FontSize="8" FontWeight="Bold"
                                                                   Foreground="{Binding BadgeForeground}"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Section name -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Section}"
                                                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Séparateur vertical fin -->
                                                    <Border Grid.Column="3" Width="1" Background="#1A1F27"
                                                            VerticalAlignment="Stretch" Margin="3,3"/>

                                                    <!-- Detail message (couleur selon type) -->
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding Detail}"
                                                               FontFamily="Consolas" FontSize="10"
                                                               Foreground="{Binding DetailForeground}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Pourcentage (visible seulement pour PROGRESS) -->
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding PercentDisplay}"
                                                               FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                               Foreground="#FF4757" HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding PercentVisibility}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ROW 1: Espace réservé -->

                    <!-- ================================================================== -->
                    <!-- ROW 2: ANNEAU DE PROGRESSION - AUCUN CLIPPING (équivalent overflow:visible) -->
                    <!-- ================================================================== -->
                    <!-- 
                    Formule étendue visuelle: (radius×2) + (stroke×2) + (blur×2) + marge_sécurité
                    radius=150 → 300, max stroke=14 → 28, blur=50 → 100, marge=32 → 460.
                    Fix 1 (converter) : centre décalé à (radius+10, radius+10) dans un viewport 300×300
                    pour que le stroke (8-10px) ne dépasse jamais les bounds du Path.
                    Fix 2 (layout) : Margin réduit de 60→10, MinHeight de 580→500 pour éviter LayoutClip
                    (580+120=700 > Row2 600 → LayoutClip à 480). Maintenant 500+20=520 < 540.
                    Viewbox supprimé : il clippait les DropShadowEffect via son ContainerVisual interne.
                    ClipToBounds=False sur TOUTE la hiérarchie (Border, Grid).
                    -->
                    <Grid x:Name="RingRowContainer" Grid.Row="2" ClipToBounds="False" 
                          MinWidth="500" MinHeight="500"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          UseLayoutRounding="True" Margin="10">
                        
                        <!-- Viewbox supprimé : il clippait les DropShadowEffect via son ContainerVisual interne.
                             Le RingOuterBorder est enfant direct du RingRowContainer (500×500 min, Margin=10),
                             laissant 20px de marge par côté pour les effets de glow. -->
                        <Border x:Name="RingOuterBorder" Width="460" Height="460" MinWidth="460" MinHeight="460"
                                ClipToBounds="False" Padding="20"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Grid x:Name="RingInnerContainer" ClipToBounds="False">
                            <Grid.Resources>
                                <Storyboard x:Key="ScanSpinnerRotation">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:1"
                                                     RepeatBehavior="Forever"/>
                                </Storyboard>
                            </Grid.Resources>
                            
                            <!-- COUCHE 1: Piste de fond (cercle gris) - 280x280, rayon 140 -->
                            <Ellipse Width="280" Height="280"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Stroke="{StaticResource BackgroundLightBrush}" 
                                     StrokeThickness="8"/>

                            <!-- COUCHE 2: Arc de progression avec glow
                                 Viewport 300×300 = 2×(radius 140 + padding 10) pour que le stroke ne dépasse pas les bounds -->
                            <Border Padding="50" ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="300" Height="300"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      ClipToBounds="False"
                                      Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                                      Opacity="{Binding SmoothProgressPercent, Converter={StaticResource ProgressToOpacity}}">
                                    <Grid.Effect>
                                        <DropShadowEffect Color="{StaticResource AccentRed}"
                                                          BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
                                    </Grid.Effect>
                                    <Path Width="300" Height="300"
                                          StrokeThickness="10"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="{Binding SmoothProgressPercent, Converter={StaticResource ProgressToArc}, ConverterParameter=140}">
                                        <Path.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{StaticResource AccentRed}" Offset="0"/>
                                                <GradientStop Color="#FFFF8B94" Offset="0.5"/>
                                                <GradientStop Color="{StaticResource AccentRed}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Path.Stroke>
                                    </Path>
                                </Grid>
                            </Border>

                            <!-- COUCHE 3: Arc de progression principal - 300x300 viewport, rayon 140 -->
                            <Path Width="300" Height="300"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{StaticResource AccentRedBrush}"
                                  StrokeThickness="8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="{Binding SmoothProgressPercent, Converter={StaticResource ProgressToArc}, ConverterParameter=140}"
                                  Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
                            
                            <!-- COUCHE 4: Cercle décoratif gradient - 280x280 -->
                            <Ellipse Width="280" Height="280"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     StrokeThickness="2"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource AccentRed}" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="0.5"/>
                                        <GradientStop Color="{StaticResource AccentRed}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>

                            <!-- COUCHE 5: Anneau rotatif segmenté - 260x260 -->
                            <Grid Width="260" Height="260"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  ClipToBounds="False"
                                  Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                                  IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform/>
                                </Grid.RenderTransform>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="ScanRingStoryboard" Storyboard="{StaticResource ScanSpinnerRotation}"/>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="ScanRingStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Ellipse Width="260" Height="260"
                                         Stroke="{StaticResource AccentRedBrush}"
                                         StrokeThickness="14"
                                         StrokeDashArray="0.04 0.96"/>
                            </Grid>

                            <!-- COUCHE 6: Bouton central - padding pour glow BlurRadius=50 -->
                            <Border Padding="50" ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="240" Height="240"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Command="{Binding StartScanCommand}"
                                    IsEnabled="{Binding CanStartScan}"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse x:Name="ButtonBackground">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush GradientOrigin="0.3,0.3">
                                                        <GradientStop Color="#FF2D333B" Offset="0"/>
                                                        <GradientStop Color="#FF161B22" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Ellipse.Fill>
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="{StaticResource AccentRed}" 
                                                                      BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            
                                            <Ellipse Stroke="{StaticResource AccentRedBrush}" 
                                                     StrokeThickness="2" Margin="10"/>
                                        </Grid>
                                        
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBackground" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="{StaticResource AccentRed}" 
                                                                      BlurRadius="50" ShadowDepth="0" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                                </Grid>
                            </Border>

                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}"
                                            IsHitTestVisible="False">
                                    <TextBlock Text="{Binding ScanButtonText}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ScanButtonSubtext}" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                
                                <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ScanButtonText}" 
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{StaticResource AccentRedBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="170"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Text="{Binding CurrentStep}" 
                                               FontSize="10" Margin="0,5,0,10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="160" TextAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <Button Content="{Binding CancelButtonText}" Width="60" Height="40"
                                            FontSize="12" Padding="0"
                                            Style="{StaticResource FuturisticButton}"
                                            Command="{Binding CancelScanCommand}"
                                            ToolTip="{Binding CancelButtonText}"/>
                                </StackPanel>
                                
                                <!-- Post-scan: Button returns to idle state immediately (no grade display) -->
                                
                                <StackPanel Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}"
                                            HorizontalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <TextBlock Text="❌" FontSize="48" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Erreur" FontSize="14"
                                               Foreground="{StaticResource AccentRedBrush}"
                                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,5,0,0"
                                               TextWrapping="Wrap" MaxWidth="180"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid><!-- Fermeture RingInnerContainer -->
                        </Border><!-- Fermeture RingOuterBorder 460×460, Padding=20, centré dans RingRowContainer 500×500 Margin=10 -->
                    </Grid><!-- Fermeture RingRowContainer -->
                    </Grid>
                    <!-- Panneau droit : gutter 12px à droite entre contenu et scrollbar -->
                    <Border Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                            CornerRadius="12" Padding="20,18" Margin="0,0,12,0"
                            VerticalAlignment="Top" ClipToBounds="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Bloc 1: Temps écoulé -->
                            <RowDefinition Height="Auto"/>  <!-- Bloc 2: Étapes -->
                            <RowDefinition Height="Auto"/>  <!-- Bloc 3: Speed Test Réseau -->
                        </Grid.RowDefinitions>
                        
                        <!-- BLOC 1: Temps écoulé (écart 12 comme entre tous les blocs) -->
                        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Temps écoulé" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ElapsedTime}" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource AccentRedBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- BLOC 2: Étapes (même écart 12 qu'entre Temps écoulé et ici) -->
                        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Étapes" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding SectionPhases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Indicateur d'état avec animation pour "Running" -->
                                                <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                                    <!-- Cercle de fond pour état Running (pulsation) -->
                                                    <Ellipse x:Name="PulseRing" Width="14" Height="14" 
                                                             Fill="Transparent" 
                                                             Stroke="{Binding StatusBrush}" 
                                                             StrokeThickness="2"
                                                             Opacity="0.3">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                        <Ellipse.RenderTransform>
                                                            <ScaleTransform CenterX="7" CenterY="7"/>
                                                        </Ellipse.RenderTransform>
                                                        <Ellipse.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                         From="0.5" To="1.5" Duration="0:0:0.8" AutoReverse="True"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                         From="0.5" To="1.5" Duration="0:0:0.8" AutoReverse="True"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0.6" To="0.1" Duration="0:0:0.8" AutoReverse="True"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Ellipse.Triggers>
                                                    </Ellipse>
                                                    
                                                    <!-- Point central (toujours visible) -->
                                                    <Ellipse Width="8" Height="8" 
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#30363D"/>
                                                                <Setter Property="Stroke" Value="{Binding StatusBrush}"/>
                                                                <Setter Property="StrokeThickness" Value="1.5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                                                        <Setter Property="Fill" Value="{Binding StatusBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                        <Setter Property="Fill" Value="{Binding StatusBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                        <Setter Property="Fill" Value="{Binding StatusBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    
                                                    <!-- Indicateur de rotation pour Running -->
                                                    <Border Width="14" Height="14" 
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.RenderTransform>
                                                            <RotateTransform/>
                                                        </Border.RenderTransform>
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                         From="0" To="360" Duration="0:0:1.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Border.Triggers>
                                                        <!-- Arc partiel pour effet spinner -->
                                                        <Ellipse Stroke="{Binding StatusBrush}" StrokeThickness="2"
                                                                 StrokeDashArray="2 3" Opacity="0.8"/>
                                                    </Border>
                                                </Grid>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                                                    <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!-- BLOC 3: Speed Test Réseau -->
                        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,0,0,0">
                            <StackPanel>
                                <!-- Titre à gauche, animation globe à droite (sprite 30fps avec 30 PNG) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Speed Test Réseau" FontSize="14" FontWeight="Bold" 
                                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                    <!-- Animation sprite 30fps: 30 frames PNG alternées via DispatcherTimer -->
                                    <Image x:Name="SpeedTestGlobeImage" Width="18" Height="18" Stretch="Uniform"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Légende couleurs (écart 12) -->
                                <StackPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bonne connexion" FontSize="10" Foreground="#4CAF50"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Ellipse Width="8" Height="8" Fill="#FFB74D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Connexion moyenne" FontSize="10" Foreground="#FFB74D"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Ellipse Width="8" Height="8" Fill="#EF5350" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mauvaise connexion" FontSize="10" Foreground="#EF5350"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Download / Upload (écart 12) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Download -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="↓ Download" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{Binding NetworkDownloadColor, Converter={StaticResource HexToColorBrush}}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:F1}">
                                                    <Binding Path="NetworkDownloadMbps" FallbackValue="—"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="Mbps" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Upload -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="↑ Upload" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{Binding NetworkUploadColor, Converter={StaticResource HexToColorBrush}}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:F1}">
                                                    <Binding Path="NetworkUploadMbps" FallbackValue="—"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="Mbps" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Bouton Toggle Tester/Arrêter (grand, centré, en bas) -->
                                <Button Command="{Binding ToggleSpeedTestCommand}" 
                                        HorizontalAlignment="Center" Cursor="Hand"
                                        Padding="32,12" MinWidth="160"
                                        Visibility="{Binding AllowExternalNetworkTests, Converter={StaticResource BoolToVisibility}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}">
                                            <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF6B7A"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSpeedTestRunning}" Value="True">
                                                    <Setter Property="Background" Value="#FF5252"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▶"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSpeedTestRunning}" Value="True">
                                                                <Setter Property="Text" Value="⏹"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Tester"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSpeedTestRunning}" Value="True">
                                                                <Setter Property="Text" Value="Arrêter"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                
                                <!-- Indicateur quand le speed test est désactivé -->
                                <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="6" Padding="12,8"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding AllowExternalNetworkTests, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                    <StackPanel>
                                        <TextBlock Text="🔒 Tests réseau désactivés" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Activer dans Paramètres → Tests réseau externes" FontSize="9"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                </Grid>
            </ScrollViewer>

            <!-- VUE CHAT -->
            <Grid Visibility="{Binding IsChatView, Converter={StaticResource BoolToVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="💬" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding ChatTitle}" FontSize="28" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding ChatSubtitle}" 
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- VUE RESULTATS -->
            <Grid Visibility="{Binding IsResultsView, Converter={StaticResource BoolToVisibility}}">
                
                <Grid Visibility="{Binding IsViewingHistoryList, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}0}">
                                <Binding Path="ResultsHistoryTitle"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <Grid Grid.Row="1">
                        <TextBlock Visibility="{Binding HasNoScanHistory, Converter={StaticResource BoolToVisibility}}"
                                  Text="{Binding ResultsMessage, FallbackValue='Aucun rapport pour le moment.'}"
                                  Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap"
                                  VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,40"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ScanHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0"
                                                    Content="⋯" FontSize="18" Padding="0"
                                                    Style="{StaticResource FuturisticButton}"
                                                    Click="OpenContextMenu"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="{Binding RenameMenuText}"
                                                                  Command="{Binding RenameScanCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="{Binding ArchiveMenuText}"
                                                                  Command="{Binding ArchiveScanCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="{Binding DeleteMenuText}"
                                                                  Command="{Binding DeleteScanCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>

                                            <Border Grid.Column="1" Width="60" Height="60" CornerRadius="12"
                                                    Background="{Binding Grade, Converter={StaticResource GradeToColor}}"
                                                    Margin="0,0,15,0">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Score}" FontSize="20" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Grade}" FontSize="12"
                                                               Foreground="White" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <!-- Titre : DisplayName (affiché) ou TextBox (mode édition inline) -->
                                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Visibility="{Binding DisplayNameVisibility}"
                                                           MouseLeftButtonDown="HistoryTitle_DoubleClick"
                                                           Cursor="Hand"
                                                           ToolTip="Double-cliquer pour renommer"/>
                                                <TextBox Text="{Binding CustomDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="16" FontWeight="SemiBold" Padding="2,0"
                                                         Foreground="{StaticResource TextPrimaryBrush}"
                                                         Background="#21262D" BorderBrush="{StaticResource AccentRedBrush}"
                                                         BorderThickness="1" CaretBrush="{StaticResource TextPrimaryBrush}"
                                                         Visibility="{Binding RenameBoxVisibility}"
                                                         MaxWidth="280" MaxLength="80" HorizontalAlignment="Left"
                                                         Tag="{Binding}"
                                                         Loaded="InlineRenameBox_Loaded"
                                                         LostFocus="InlineRenameBox_LostFocus"
                                                         KeyDown="InlineRenameBox_KeyDown"/>
                                                <!-- Sous-titre : date + score (ou juste score si pas renommé) -->
                                                <TextBlock Text="{Binding SubtitleDisplay}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="→" FontSize="24"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <Grid.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.SelectHistoryScanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </Grid.InputBindings>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Button Grid.Row="2" Content="{Binding ArchivesButtonText}" 
                            Style="{StaticResource FuturisticButton}"
                            Command="{Binding NavigateToArchivesCommand}"
                            HorizontalAlignment="Right" Margin="0,20,0,0"/>
                </Grid>

                <Grid Visibility="{Binding IsViewingHistoryDetail, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <Button Content="{Binding ResultsBackButton}" 
                                Style="{StaticResource FuturisticButton}"
                                Command="{Binding BackToHistoryCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,20,0"/>
                        <StackPanel>
                            <TextBlock FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}0}">
                                        <Binding Path="ResultsDetailTitle"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <!-- Nom du rapport avec option de renommage (même pattern data-bound que Page A) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Display mode -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding SelectedHistoryScan.DisplayNameVisibility}">
                                    <TextBlock Text="{Binding SelectedHistoryScan.DisplayName}" 
                                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" 
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" — " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SelectedHistoryScan.HasCustomName, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{Binding SelectedScanDateDisplay}" 
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" 
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SelectedHistoryScan.HasCustomName, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                                <!-- Edit mode (same inline TextBox pattern as Page A) -->
                                <TextBox Text="{Binding SelectedHistoryScan.CustomDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="14" Padding="4,2" MaxWidth="300" MaxLength="80"
                                         HorizontalAlignment="Left"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Background="#21262D" BorderBrush="{StaticResource AccentRedBrush}"
                                         BorderThickness="1" CaretBrush="{StaticResource TextPrimaryBrush}"
                                         Visibility="{Binding SelectedHistoryScan.RenameBoxVisibility}"
                                         Tag="{Binding SelectedHistoryScan}"
                                         Loaded="InlineRenameBox_Loaded"
                                         LostFocus="InlineRenameBox_LostFocus"
                                         KeyDown="InlineRenameBox_KeyDown"/>
                                <!-- Pencil button triggers RenameScanCommand -->
                                <Button Grid.Column="1" Content="✏️" FontSize="12" Padding="6,2" Margin="8,0,0,0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Renommer ce rapport"
                                        Click="ReportPencil_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Margin="0,0,0,10" Background="Transparent"
                                    Visibility="{Binding HasResultsMessage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ResultsMessage}" FontSize="14" TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentRedBrush}"/>
                            </Border>

                            <!-- ══════════════════════════════════════════════════════════════════ -->
                            <!-- BLOC INDICE GLOBAL DE SANTÉ — Thème Imperial Command Console        -->
                            <!-- Layout 3 colonnes: Gauge | Grade+Info | Légende                      -->
                            <!-- ══════════════════════════════════════════════════════════════════ -->
                            <Border Margin="0,0,0,20" CornerRadius="6" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0A0C10" Offset="0"/>
                                        <GradientStop Color="#0F1218" Offset="0.5"/>
                                        <GradientStop Color="#0A0C10" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1A1F28" Offset="0"/>
                                        <GradientStop Color="#2A1015" Offset="0.5"/>
                                        <GradientStop Color="#1A1F28" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1</Border.BorderThickness>
                                <Grid>
                                    <!-- Scanline overlay très subtile -->
                                    <Border Opacity="0.03">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" SpreadMethod="Repeat"
                                                                 MappingMode="Absolute">
                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                <GradientStop Color="Transparent" Offset="0.5"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Vignette sombre (coins) -->
                                    <Border Opacity="0.5">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                                                <GradientStop Color="Transparent" Offset="0.3"/>
                                                <GradientStop Color="#80000000" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Layout 3 colonnes: Gauge | Grade+Info | Légende (sans emblème) -->
                                    <Grid Margin="20,16,20,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- COL 0: GAUGE CIRCULAIRE avec glow -->
                                        <Grid Grid.Column="0" Width="170" Height="170" HorizontalAlignment="Center"
                                              Opacity="{Binding ScoreCircleOpacity}">
                                            <Grid.Effect>
                                                <DropShadowEffect Color="{StaticResource AccentGreen}"
                                                                  BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
                                            </Grid.Effect>
                                            <Ellipse Stroke="#1A1F28" StrokeThickness="8" Opacity="0.6"/>
                                            <Ellipse Stroke="#1A1F28" StrokeThickness="1" StrokeDashArray="1,3" Width="150" Height="150"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                            <Path Stroke="{Binding DisplayGrade, Converter={StaticResource GradeToColor}}"
                                                  StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="{Binding ScanResult.Summary.Score, Converter={StaticResource ProgressToArc}, ConverterParameter=76}"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ScanResult.Summary.Score}" FontSize="42" FontWeight="Bold"
                                                           Foreground="{Binding DisplayGrade, Converter={StaticResource GradeToColor}}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="/100" FontSize="11" Foreground="#4D5566"
                                                           HorizontalAlignment="Center" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- COL 1: GRADE + SCORE INFO -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,20,0" MinWidth="180">
                                            <TextBlock Text="Collecte partielle" FontSize="11" Foreground="#FFA726" FontWeight="SemiBold"
                                                       Visibility="{Binding ShowPartialCollectionBadge, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding DisplayGrade}" FontSize="52" FontWeight="Bold"
                                                       Foreground="{Binding DisplayGrade, Converter={StaticResource GradeToColor}}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="{StaticResource AccentGreen}"
                                                                      BlurRadius="15" ShadowDepth="0" Opacity="0.45"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="{Binding StatusWithScore}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="#6B7685" Margin="0,2,0,0" FontFamily="Consolas"/>
                                            <TextBlock Text="{Binding UnifiedReliabilityDisplay}" FontSize="10" Foreground="#6B7685" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- COL 2: LÉGENDE (Échelle d'évaluation) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="10,0,0,0">
                                            <TextBlock Text="Indice global de santé du système (0 à 100)" FontSize="12" FontWeight="Bold"
                                                       Foreground="#8B949E" Margin="0,0,0,2" FontFamily="Consolas"/>
                                            <TextBlock Text="Ce score combine le niveau de risque et la performance globale.&#x0a;Plus le score est élevé, plus le système est stable, performant et sécurisé."
                                                       FontSize="10" Foreground="#4D5566" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                            <TextBlock Text="Échelle d'évaluation" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#6B7685" Margin="0,0,0,6"/>

                                            <!-- A+ -->
                                            <Grid Margin="0,0,0,2" Opacity="{Binding DisplayGrade, ConverterParameter=A+, Converter={StaticResource GradeMatchOpacity}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="56"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#4CAF50" HorizontalAlignment="Center"><TextBlock Text="A+" FontSize="8" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Grid.Column="1" Text="95 à 100" FontSize="10" Foreground="#6B7685" VerticalAlignment="Center" Margin="3,0,0,0" FontFamily="Consolas"/>
                                                <Border Grid.Column="2" Width="2" CornerRadius="1" Background="#4CAF50" VerticalAlignment="Stretch" Margin="0,2"/>
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"><Run Text="Exceptionnel" FontWeight="Bold" Foreground="#4CAF50"/><Run Text="  Système optimal, aucun risque significatif" Foreground="#4D5566" FontSize="9"/></TextBlock>
                                            </Grid>
                                            <!-- A -->
                                            <Grid Margin="0,0,0,2" Opacity="{Binding DisplayGrade, ConverterParameter=A, Converter={StaticResource GradeMatchOpacity}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="56"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#66BB6A" HorizontalAlignment="Center"><TextBlock Text="A" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Grid.Column="1" Text="90 à 94" FontSize="10" Foreground="#6B7685" VerticalAlignment="Center" Margin="3,0,0,0" FontFamily="Consolas"/>
                                                <Border Grid.Column="2" Width="2" CornerRadius="1" Background="#66BB6A" VerticalAlignment="Stretch" Margin="0,2"/>
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"><Run Text="Excellent" FontWeight="Bold" Foreground="#66BB6A"/><Run Text="  Performance très élevée, risques minimes" Foreground="#4D5566" FontSize="9"/></TextBlock>
                                            </Grid>
                                            <!-- B -->
                                            <Grid Margin="0,0,0,2" Opacity="{Binding DisplayGrade, ConverterParameter=B, Converter={StaticResource GradeMatchOpacity}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="56"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#AED581" HorizontalAlignment="Center"><TextBlock Text="B" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Grid.Column="1" Text="80 à 89" FontSize="10" Foreground="#6B7685" VerticalAlignment="Center" Margin="3,0,0,0" FontFamily="Consolas"/>
                                                <Border Grid.Column="2" Width="2" CornerRadius="1" Background="#AED581" VerticalAlignment="Stretch" Margin="0,2"/>
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"><Run Text="Très bon" FontWeight="Bold" Foreground="#AED581"/><Run Text="  Système sain, quelques optimisations possibles" Foreground="#4D5566" FontSize="9"/></TextBlock>
                                            </Grid>
                                            <!-- C -->
                                            <Grid Margin="0,0,0,2" Opacity="{Binding DisplayGrade, ConverterParameter=C, Converter={StaticResource GradeMatchOpacity}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="56"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#FFD54F" HorizontalAlignment="Center"><TextBlock Text="C" FontSize="9" FontWeight="Bold" Foreground="#1C1C1C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Grid.Column="1" Text="70 à 79" FontSize="10" Foreground="#6B7685" VerticalAlignment="Center" Margin="3,0,0,0" FontFamily="Consolas"/>
                                                <Border Grid.Column="2" Width="2" CornerRadius="1" Background="#FFD54F" VerticalAlignment="Stretch" Margin="0,2"/>
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"><Run Text="Acceptable" FontWeight="Bold" Foreground="#FFD54F"/><Run Text="  Faiblesses modérées détectées" Foreground="#4D5566" FontSize="9"/></TextBlock>
                                            </Grid>
                                            <!-- D -->
                                            <Grid Margin="0,0,0,2" Opacity="{Binding DisplayGrade, ConverterParameter=D, Converter={StaticResource GradeMatchOpacity}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="56"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#FFA726" HorizontalAlignment="Center"><TextBlock Text="D" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Grid.Column="1" Text="60 à 69" FontSize="10" Foreground="#6B7685" VerticalAlignment="Center" Margin="3,0,0,0" FontFamily="Consolas"/>
                                                <Border Grid.Column="2" Width="2" CornerRadius="1" Background="#FFA726" VerticalAlignment="Stretch" Margin="0,2"/>
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"><Run Text="Fragile" FontWeight="Bold" Foreground="#FFA726"/><Run Text="  Risques identifiés, corrections recommandées" Foreground="#4D5566" FontSize="9"/></TextBlock>
                                            </Grid>
                                            <!-- E -->
                                            <Grid Margin="0,0,0,2" Opacity="{Binding DisplayGrade, ConverterParameter=E, Converter={StaticResource GradeMatchOpacity}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="56"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#EF5350" HorizontalAlignment="Center"><TextBlock Text="E" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Grid.Column="1" Text="50 à 59" FontSize="10" Foreground="#6B7685" VerticalAlignment="Center" Margin="3,0,0,0" FontFamily="Consolas"/>
                                                <Border Grid.Column="2" Width="2" CornerRadius="1" Background="#EF5350" VerticalAlignment="Stretch" Margin="0,2"/>
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"><Run Text="Critique" FontWeight="Bold" Foreground="#EF5350"/><Run Text="  Instabilités ou vulnérabilités importantes" Foreground="#4D5566" FontSize="9"/></TextBlock>
                                            </Grid>
                                            <!-- F -->
                                            <Grid Margin="0,0,0,0" Opacity="{Binding DisplayGrade, ConverterParameter=F, Converter={StaticResource GradeMatchOpacity}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="56"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#C62828" HorizontalAlignment="Center"><TextBlock Text="F" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Grid.Column="1" Text="0 à 49" FontSize="10" Foreground="#6B7685" VerticalAlignment="Center" Margin="3,0,0,0" FontFamily="Consolas"/>
                                                <Border Grid.Column="2" Width="2" CornerRadius="1" Background="#C62828" VerticalAlignment="Stretch" Margin="0,2"/>
                                                <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0"><Run Text="Défaillant" FontWeight="Bold" Foreground="#C62828"/><Run Text="  Intervention urgente requise" Foreground="#4D5566" FontSize="9"/></TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ========== TABLEAU DE SANTÉ PC (8 DOMAINES) — HUD Panel ========== -->
                            <Border Style="{StaticResource HudPanel}" Margin="0,0,0,20"
                                    Visibility="{Binding HasHealthReport, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <!-- En-tête avec titre et score État uniquement -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <!-- Icône santé robuste: texte + Unicode heart (pas emoji problématique) -->
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="24" Height="24" CornerRadius="12" 
                                                        Background="{StaticResource AccentRedBrush}" Margin="0,0,4,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" 
                                                               Foreground="White" HorizontalAlignment="Center" 
                                                               VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                </Border>
                                                <TextBlock Text="Santé de votre PC" FontWeight="Bold" FontSize="18"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding GlobalHealthMessage}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <!-- HEALTH SCORE (état machine) - Écusson supprimé -->
                                    </Grid>
                                    
                                    <!-- Zone dédiée "Qualité Collecte" - Toujours visible (indicateur de fiabilité) -->
                                    <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="4" 
                                            Padding="10,8" Margin="0,0,0,12"
                                            Visibility="{Binding HasScanResult, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Badge et message d'erreur collecteur -->
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Qualité collecte" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Command="{Binding ShowCollectorErrorsCommand}"
                                                        Background="#FFF3E0" BorderThickness="0" Padding="6,3" Margin="0,4,0,0"
                                                        Cursor="Hand" HorizontalAlignment="Left" MaxWidth="280">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="btnBorder" Property="Background" Value="#FFE0B2"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚠️" FontSize="11" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding CollectionStatusBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#E65100"/>
                                                        <TextBlock Text="{Binding CollectorErrorsLogicalDisplay}" FontSize="9" Foreground="#BF360C" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            
                                            <!-- Score de collecte déplacé vers préambule du rapport détaillé -->
                                        </Grid>
                                    </Border>
                                    
                                            <!-- NOTE: Santé machine / Fiabilité UDIS / AutoFix déplacés dans la fenêtre "Détails des erreurs de collecte" -->
                                    <!-- NOTE: Métriques Thermal/Boot/IO/Stabilité supprimées du premier écran (redondantes avec sections détaillées) -->
                                    <!-- NOTE: Speed Test Réseau déplacé vers la page de scan (panneau droit) -->
                                    
                                    <!-- Liste des 8 domaines - CLIQUABLES avec expansion (sans flèches, effet pressé) -->
                                    <ItemsControl ItemsSource="{Binding HealthSections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Expandable box with inset styling (no arrows) -->
                                                <Border CornerRadius="12" Margin="0,0,0,6" ClipToBounds="False">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource ExpandableBoxBorderBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <!-- Active state (expanded): dark bg + red border + red glow -->
                                                                <DataTrigger Binding="{Binding IsExpanded, ElementName=SectionExpander}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource ExpandableBoxActiveBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource ExpandableBoxActiveBorderBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect Color="{StaticResource AccentRed}" 
                                                                                              BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Expander x:Name="SectionExpander" IsExpanded="False" Style="{StaticResource ExpanderNoArrowStyle}">
                                                        <Expander.Header>
                                                            <!-- Clickable box with glow effects (hover + expanded pulsation) -->
                                                            <Border x:Name="HeaderBorder" CornerRadius="12" Padding="8,12" Cursor="Hand"
                                                                    ClipToBounds="False">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="Effect" Value="{StaticResource InsetShadowBase}"/>
                                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                                        <Style.Triggers>
                                                                            <!-- Hover: lumière rouge luminescente diffuse (~200ms transition) -->
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Effect" Value="{StaticResource RedGlow}"/>
                                                                            </Trigger>
                                                                            <!-- Expanded: glow rouge luminescent pulsant (pas de fond blanc, pas d'outline) -->
                                                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                                <Setter Property="Background" Value="Transparent"/>
                                                                                <Setter Property="Effect">
                                                                                    <Setter.Value>
                                                                                        <DropShadowEffect x:Name="ExpandedGlow" Color="{StaticResource AccentRed}" 
                                                                                                          BlurRadius="35" ShadowDepth="0" Opacity="0.7"/>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard x:Name="PulseGlow">
                                                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                                                             From="0.5" To="0.9" Duration="0:0:0.8">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <SineEase EasingMode="EaseInOut"/>
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                                             From="25" To="45" Duration="0:0:0.8">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <SineEase EasingMode="EaseInOut"/>
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                                <DataTrigger.ExitActions>
                                                                                    <StopStoryboard BeginStoryboardName="PulseGlow"/>
                                                                                </DataTrigger.ExitActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    
                                                                    <!-- Icône domaine (ex: 🖥️ Système d'exploitation) - rapprochée du texte -->
                                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" 
                                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    
                                                                    <!-- Nom domaine + message (ex: "Système d'exploitation" / "Excellent état") -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                        <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                    
                                                                    <!-- Score (ex: 100/100 or N/A when evaluation unavailable) -->
                                                                    <TextBlock Grid.Column="2" Text="{Binding Score, Converter={StaticResource PerformanceScoreToDisplay}, ConverterParameter=WithSuffix}" 
                                                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToColor}}"
                                                                               Margin="10,0,10,0"/>
                                                                    
                                                                    <!-- Icône état : cercle avec coche (hidden when Performance and evaluation unavailable) -->
                                                                    <Border Grid.Column="3" Width="28" Height="28" CornerRadius="14"
                                                                            Background="{Binding Severity, Converter={StaticResource SeverityToColor}}"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding Converter={StaticResource PerformanceHeaderAvailabilityToVisibility}}">
                                                                        <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToIcon}}" 
                                                                                   FontSize="14" FontWeight="Bold" Foreground="White"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    
                                                                    <!-- Alerte ! si critique -->
                                                                    <TextBlock Grid.Column="4" Text="!" FontSize="18" FontWeight="Bold"
                                                                               Foreground="#FF4757" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                               Visibility="{Binding Severity, Converter={StaticResource SeverityToAlertVisibility}}"/>
                                                                </Grid>
                                                            </Border>
                                                        </Expander.Header>
                                                        
                                                        <!-- Panel de détails (visible quand expanded): Performance dashboard OU contenu par défaut -->
                                                        <Border Background="{StaticResource BackgroundDarkBrush}" 
                                                                CornerRadius="0,0,6,6" Padding="16,12" Margin="0,-4,0,0">
                                                            <Grid>
                                                                <!-- Performance: Capability Dashboard (Executive + Matrix + Bar chart) -->
                                                                <StackPanel Visibility="{Binding Domain, Converter={StaticResource HealthDomainToVisibility}}">
                                                                    <Border Visibility="{Binding PerformanceScenarioRows, Converter={StaticResource CollectionNotEmptyToVisibility}, ConverterParameter=Invert}"
                                                                            Background="#1A2129" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                                                                        <TextBlock Text="Données de performance non disponibles" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center"/>
                                                                    </Border>
                                                                    <StackPanel Visibility="{Binding PerformanceScenarioRows, Converter={StaticResource CollectionNotEmptyToVisibility}}">
                                                                        <!-- Executive Summary Card -->
                                                                        <Border Background="#161B22" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="#30363D" BorderThickness="1">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                                                               Text="{Binding Score, Converter={StaticResource PerformanceScoreToDisplay}, ConverterParameter=WithSuffix}"/>
                                                                                    <TextBlock Text="{Binding PerformanceCategory}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding PrimaryBottleneck}" FontSize="11" Foreground="{StaticResource AccentYellowBrush}" FontWeight="SemiBold"/>
                                                                                    <TextBlock Text="Facteur limitant principal" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                                                    <TextBlock Text="{Binding RealisticSummary}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                        <!-- Evidence: specs used (CPU, GPU, VRAM, RAM, Storage) -->
                                                                        <TextBlock Text="Spécifications utilisées" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                                                        <Border Background="#21262D" CornerRadius="8" Padding="10,8" Margin="0,0,0,14" BorderBrush="#30363D" BorderThickness="1">
                                                                            <StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                                    <TextBlock Text="CPU : " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                    <TextBlock Text="{Binding PerformanceCpuDisplay}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                                    <TextBlock Text="GPU : " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                    <TextBlock Text="{Binding PerformanceGpuDisplay}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                                    <TextBlock Text="VRAM (dédiée) : " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                    <TextBlock Text="{Binding PerformanceVramDisplay}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                                    <TextBlock Text="RAM : " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                    <TextBlock Text="{Binding PerformanceRamDisplay}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="Type de stockage : " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                    <TextBlock Text="{Binding PerformanceStorageDisplay}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <!-- Capability Matrix -->
                                                                        <TextBlock Text="Matrice des capacités" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                                                        <ItemsControl ItemsSource="{Binding PerformanceScenarioRows}" Margin="0,0,0,14">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Background="#21262D" CornerRadius="8" Padding="10,8" Margin="0,0,8,8" MinWidth="160" BorderBrush="#30363D" BorderThickness="1">
                                                                                        <StackPanel>
                                                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                                                            <Grid Margin="0,4,0,0">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <Border Grid.Column="0" Height="8" CornerRadius="4" Margin="0,0,6,0" HorizontalAlignment="Stretch" Background="#30363D">
                                                                                                    <Border HorizontalAlignment="Left" Height="8" CornerRadius="4"
                                                                                                            Width="{Binding Score, Converter={StaticResource ScoreToBarWidth}, ConverterParameter=100}"
                                                                                                            Background="{Binding Score, Converter={StaticResource ScoreToPerformanceBrush}}"/>
                                                                                                </Border>
                                                                                                <TextBlock Grid.Column="1" Text="{Binding Score, Converter={StaticResource PerformanceScoreToDisplay}}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                                            </Grid>
                                                                                            <Border Margin="0,4,0,0" Padding="4,2" CornerRadius="4" Background="{Binding Score, Converter={StaticResource ScoreToPerformanceBrush}}">
                                                                                                <TextBlock Text="{Binding Classification}" FontSize="9" Foreground="White"/>
                                                                                            </Border>
                                                                                        </StackPanel>
                                                                                        <Border.ToolTip>
                                                                                            <ToolTip>
                                                                                                <TextBlock>
                                                                                                    <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                                                    <Run Text=" — "/>
                                                                                                    <Run Text="{Binding Classification}"/>
                                                                                                    <Run Text=" (score "/>
                                                                                                    <Run Text="{Binding Score, Converter={StaticResource PerformanceScoreToDisplay}, ConverterParameter=WithSuffix}"/>
                                                                                                    <Run Text=")"/>
                                                                                                </TextBlock>
                                                                                            </ToolTip>
                                                                                        </Border.ToolTip>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <!-- Bar chart -->
                                                                        <TextBlock Text="Scores par scénario" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                                                        <Border Background="#161B22" CornerRadius="10" Padding="12" BorderBrush="#30363D" BorderThickness="1">
                                                                            <ItemsControl ItemsSource="{Binding PerformanceScenarioRows}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Border Margin="0,4,0,4" Padding="0" ToolTip="{Binding Classification}">
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="150"/>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                    <ColumnDefinition Width="40"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                                                                <Border Grid.Column="1" Height="16" CornerRadius="6" Margin="6,0" Background="#21262D">
                                                                                                    <Border HorizontalAlignment="Left" Height="16" CornerRadius="6"
                                                                                                            Width="{Binding Score, Converter={StaticResource ScoreToBarWidth}}"
                                                                                                            Background="{Binding Score, Converter={StaticResource ScoreToPerformanceBrush}}"/>
                                                                                                </Border>
                                                                                                <TextBlock Grid.Column="2" Text="{Binding Classification}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                                            </Grid>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </Border>
                                                                        <!-- Confidence (report-level; hidden when no confidence data) -->
                                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                                                    Visibility="{Binding DataContext.ConfidenceScore, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IntGreaterThanZeroToVisibility}}">
                                                                            <TextBlock Text="Confiance : " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding DataContext.ConfidenceDisplay, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <!-- Default section content (non-Performance) -->
                                                                <StackPanel Visibility="{Binding Domain, Converter={StaticResource HealthDomainToVisibility}, ConverterParameter=Invert}">
                                                                <!-- Explication détaillée -->
                                                                <TextBlock Text="{Binding DetailedExplanation}" 
                                                                           TextWrapping="Wrap" FontSize="12"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           Margin="0,0,0,12"/>
                                                                
                                                                <!-- Données utilisées -->
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="📊 Données analysées" FontWeight="Bold" FontSize="15"
                                                                               Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                    
                                                                    <!-- Bouton "Voir détails" pour Pilotes -->
                                                                    <Button Grid.Column="1" Content="Voir tous les pilotes"
                                                                            Command="{Binding DataContext.OpenDriversDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            Background="{StaticResource AccentBlueBrush}"
                                                                            FontSize="10" Padding="10,4" Cursor="Hand">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Domain}" Value="Drivers">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                    
                                                                    <!-- Bouton "Voir détails" pour Applications -->
                                                                    <Button Grid.Column="1" Content="Voir toutes les apps"
                                                                            Command="{Binding DataContext.OpenAppsDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            Background="{StaticResource AccentBlueBrush}"
                                                                            FontSize="10" Padding="10,4" Cursor="Hand">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource FuturisticButton}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Domain}" Value="Applications">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </Grid>
                                                                
                                                                <!-- Liste données (style flexbox): label 200px, valeur flexible, indicateur à droite avec gap 8px -->
                                                                <ItemsControl ItemsSource="{Binding EvidenceDataWithTooltips}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Padding="12,0" Margin="0,0,0,0" BorderThickness="0,0,0,1" BorderBrush="#0DFFFFFF">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                                        <Style.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter Property="Background" Value="#0800D4FF"/>
                                                                                            </Trigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="200"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <!-- Colonne 0: bloc gauche (optionnel ℹ️ + label) -->
                                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <!-- (i) Kernel Power ID 1 : ouvre KernelPowerInfoWindow (visible seulement si HasKernelPowerId1) -->
                                                                                        <Button Width="20" Height="20" VerticalAlignment="Center" Cursor="Hand" Click="OpenKernelPowerInfoWindow"
                                                                                                ToolTip="Explication Kernel Power ID 1 vs 41" Margin="0,0,4,0">
                                                                                            <Button.Visibility>
                                                                                                <MultiBinding Converter="{StaticResource KernelPowerInfoButtonVisibility}">
                                                                                                    <Binding Path="Key"/>
                                                                                                    <Binding Path="DataContext.HasKernelPowerId1" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                                                </MultiBinding>
                                                                                            </Button.Visibility>
                                                                                            <Button.Template>
                                                                                                <ControlTemplate TargetType="Button">
                                                                                                    <Border x:Name="kpInfoBorder" CornerRadius="10" Background="#2196F3">
                                                                                                        <TextBlock Text="ℹ️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
                                                                                                    </Border>
                                                                                                    <ControlTemplate.Triggers>
                                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                                            <Setter TargetName="kpInfoBorder" Property="Background" Value="#FF2B2B"/>
                                                                                                            <Setter TargetName="kpInfoBorder" Property="Effect">
                                                                                                                <Setter.Value>
                                                                                                                    <DropShadowEffect Color="#FF2B2B" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
                                                                                                                </Setter.Value>
                                                                                                            </Setter>
                                                                                                        </Trigger>
                                                                                                    </ControlTemplate.Triggers>
                                                                                                </ControlTemplate>
                                                                                            </Button.Template>
                                                                                        </Button>
                                                                                        <Button Width="20" Height="20" VerticalAlignment="Center" Cursor="Hand" Click="OpenCyberpunkInfoWindow"
                                                                                                Visibility="{Binding ShouldShowInfoIcon, Converter={StaticResource BoolToVisibility}}"
                                                                                                ToolTipService.IsEnabled="False" Margin="0,0,8,0">
                                                                                            <Button.Template>
                                                                                                <ControlTemplate TargetType="Button">
                                                                                                    <Border x:Name="infoBorder" CornerRadius="10" Background="#2196F3">
                                                                                                        <TextBlock Text="ℹ️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9"/>
                                                                                                    </Border>
                                                                                                    <ControlTemplate.Triggers>
                                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                                            <Setter TargetName="infoBorder" Property="Background" Value="#FF2B2B"/>
                                                                                                            <Setter TargetName="infoBorder" Property="Effect">
                                                                                                                <Setter.Value>
                                                                                                                    <DropShadowEffect Color="#FF2B2B" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
                                                                                                                </Setter.Value>
                                                                                                            </Setter>
                                                                                                        </Trigger>
                                                                                                    </ControlTemplate.Triggers>
                                                                                                </ControlTemplate>
                                                                                            </Button.Template>
                                                                                        </Button>
                                                                                        <ContentControl Content="{Binding}" VerticalContentAlignment="Center">
                                                                                            <ContentControl.Style>
                                                                                                <Style TargetType="ContentControl">
                                                                                                    <Setter Property="ContentTemplate">
                                                                                                        <Setter.Value>
                                                                                                            <DataTemplate>
                                                                                                                <TextBox Text="{Binding Key, Mode=OneWay}" Style="{StaticResource SelectableTextSecondaryStyle}" FontSize="14"/>
                                                                                                            </DataTemplate>
                                                                                                        </Setter.Value>
                                                                                                    </Setter>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsListDetailKey}" Value="True">
                                                                                                            <Setter Property="ContentTemplate">
                                                                                                                <Setter.Value>
                                                                                                                    <DataTemplate>
                                                                                                                        <Button Content="{Binding Key}"
                                                                                                                                Command="{Binding DataContext.OpenListDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                                                CommandParameter="{Binding Key}"
                                                                                                                                Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                                                                                                                Foreground="#2196F3" Cursor="Hand">
                                                                                                                            <Button.Template>
                                                                                                                                <ControlTemplate TargetType="Button">
                                                                                                                                    <TextBlock Text="{TemplateBinding Content}" Foreground="#2196F3" TextDecorations="Underline" Cursor="Hand"/>
                                                                                                                                </ControlTemplate>
                                                                                                                            </Button.Template>
                                                                                                                        </Button>
                                                                                                                    </DataTemplate>
                                                                                                                </Setter.Value>
                                                                                                            </Setter>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </ContentControl.Style>
                                                                                        </ContentControl>
                                                                                    </StackPanel>
                                                                                    <!-- Colonne 1: valeur (flexible) -->
                                                                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableTextStyle}"
                                                                                             FontSize="15" FontWeight="Medium" Margin="24,0,0,0"/>
                                                                                    <!-- Colonne 2: indicateur à droite (⚠️ avertissement, 🚨 danger uniquement) -->
                                                                                    <Border Grid.Column="2" Width="32" Height="32" CornerRadius="6" Margin="8,0,8,0"
                                                                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                                        <Border.Style>
                                                                                            <Style TargetType="Border">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding StatusIcon}" Value="⚠">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                        <Setter Property="Background" Value="#1FFFC000"/>
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding StatusIcon}" Value="🚨">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                        <Setter Property="Background" Value="#1FFF4444"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Border.Style>
                                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding StatusIcon}" Value="⚠">
                                                                                                            <Setter Property="Text" Value="⚠️"/>
                                                                                                            <Setter Property="Foreground" Value="#FFC000"/>
                                                                                                        </DataTrigger>
                                                                                                        <DataTrigger Binding="{Binding StatusIcon}" Value="🚨">
                                                                                                            <Setter Property="Text" Value="🚨"/>
                                                                                                            <Setter Property="Foreground" Value="#FF4444"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </Border>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                
                                                                <!-- PARTIE 5: Mini-tableau Top 5 processus RAM (visible seulement pour section Mémoire) -->
                                                                <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="4" 
                                                                        Padding="10,8" Margin="0,10,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Domain}" Value="RAM">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Top 5 processus RAM" FontWeight="SemiBold" FontSize="11"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="30"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="80"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold" FontSize="10" 
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            <TextBlock Grid.Column="1" Text="Processus" FontWeight="SemiBold" FontSize="10" 
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            <TextBlock Grid.Column="2" Text="RAM" FontWeight="SemiBold" FontSize="10" 
                                                                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                                        </Grid>
                                                                        <ItemsControl ItemsSource="{Binding DataContext.Top5RamProcesses, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,3,0,0">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="30"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="80"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="10" 
                                                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}" FontSize="10" 
                                                                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding RamUsedDisplay}" FontSize="10" 
                                                                                                   Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                                
                                                                <!-- PARTIE 9: Mini-tableau Top 5 CPU pour section Applications -->
                                                                <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="4" 
                                                                        Padding="10,8" Margin="0,10,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Domain}" Value="Applications">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel>
                                                                        <TextBlock Text="Top 5 processus CPU" FontWeight="SemiBold" FontSize="11"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="30"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold" FontSize="10" 
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            <TextBlock Grid.Column="1" Text="Processus" FontWeight="SemiBold" FontSize="10" 
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                            <TextBlock Grid.Column="2" Text="CPU" FontWeight="SemiBold" FontSize="10" 
                                                                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                                        </Grid>
                                                                        <ItemsControl ItemsSource="{Binding DataContext.Top5CpuProcesses, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,3,0,0">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="30"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="60"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="10" 
                                                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}" FontSize="10" 
                                                                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                                        <TextBlock Grid.Column="2" Text="{Binding CpuDisplay}" FontSize="10" 
                                                                                                   Foreground="#FF6B6B" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Border>
                                                                
                                                                <!-- Recommandations -->
                                                                <TextBlock Text="Recommandations" FontWeight="SemiBold" FontSize="11"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,6"
                                                                           Visibility="{Binding SectionRecommendations.Count, Converter={StaticResource BoolToVisibility}}"/>
                                                                <ItemsControl ItemsSource="{Binding SectionRecommendations}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="11"
                                                                                       Foreground="{StaticResource AccentRedBrush}"
                                                                                       TextWrapping="Wrap" Margin="0,2"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Expander>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- ========== FIN TABLEAU DE SANTÉ ========== -->

                            <!-- SECTIONS TECHNIQUES SUPPRIMÉES (missing Data, score V2, metadata, findings, errors, sections, paths)
                                 Ces données restent collectées dans le JSON mais ne sont plus affichées dans l'UI -->
                        </StackPanel>
                    </ScrollViewer>

                    <!-- BOUTON RAPPORT INTÉGRALE CENTRÉ EN BAS -->
                    <Border Grid.Row="2" Padding="0,15,0,10">
                        <Button Content="Rapport intégrale" 
                                Style="{StaticResource FuturisticButton}"
                                Command="{Binding OpenReportTxtCommand}"
                                HorizontalAlignment="Center"
                                Padding="20,10"
                                FontSize="14"
                                ToolTip="Ouvre le rapport unifié complet"/>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding IsViewingArchives, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <Button Content="{Binding ResultsBackButton}" 
                                Style="{StaticResource FuturisticButton}"
                                Command="{Binding BackToHistoryCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,20,0"/>
                        <TextBlock FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}0}">
                                    <Binding Path="ArchivesTitle"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ArchivedScanHistoryView.Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,20">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Cursor="Hand">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding DayDisplay}" FontSize="20"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center" Margin="0,0,15,0"
                                                                       IsHitTestVisible="False"/>

                                                            <Border Grid.Column="1" Width="60" Height="60" CornerRadius="12"
                                                                    Background="{Binding Grade, Converter={StaticResource GradeToColor}}"
                                                                    Margin="0,0,15,0">
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Score}" FontSize="20" FontWeight="Bold"
                                                                               Foreground="White" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Grade}" FontSize="12"
                                                                               Foreground="White" HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DateDisplay}" FontSize="16" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding ScoreDisplay}" FontSize="12"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="3" Text="→" FontSize="24"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center"/>

                                                            <Grid.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" 
                                                                              Command="{Binding DataContext.SelectHistoryScanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Grid.InputBindings>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- VUE PARAMETRES -->
            <Grid Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,30">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="⚙️ {0}">
                            <Binding Path="SettingsTitle"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,20"
                                Height="{StaticResource CompactPanelHeight}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReportsDirectoryTitle}" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding ReportsDirectoryDescription}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Text="{Binding ReportDirectory, Mode=TwoWay}"
                                         IsReadOnly="True" Margin="0,0,10,0"/>
                                
                                <Button Grid.Column="1" Content="{Binding BrowseButtonText}"
                                        Style="{StaticResource FuturisticButton}"
                                        Command="{Binding BrowseReportDirectoryCommand}"
                                        Padding="20,10"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{Binding LanguageTitle}" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding LanguageDescription}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,15"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LanguageLabel}" 
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          Width="200"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Sélecteur de thème UI (optionnel) -->
                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🎨" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thème de l'interface" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Personnalisez l'apparence de l'application. Le thème par défaut (Dark Futuriste) est recommandé."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Thème : " 
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          Width="200"/>
                            </StackPanel>
                            <TextBlock Text="Le thème s'applique dès que vous cliquez sur Enregistrer."
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Surveillance matérielle avec onboarding Defender progressif et rassurant -->
                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🌡️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Surveillance matérielle" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12">
                                Cette option permet de lire les températures CPU et GPU en temps réel via LibreHardwareMonitor.
                                <LineBreak/>C'est un outil open-source sûr utilisé par de nombreux logiciels de monitoring.
                                <LineBreak/><Run FontStyle="Italic">Sans alerte Defender : lancez HWiNFO64 (Sensors Only) avec « Shared Memory Support » activé ; l'app lira la température CPU sans charger de pilote.</Run>
                            </TextBlock>
                            
                            <CheckBox IsChecked="{Binding EnableHardwareMonitoring, Mode=TwoWay}" Margin="0,0,0,15"
                                      Foreground="{StaticResource TextPrimaryBrush}">
                                <CheckBox.Content>
                                    <TextBlock>
                                        <Run Text="Activer la surveillance matérielle" FontWeight="SemiBold"/>
                                        <Run Text=" (recommandé pour un diagnostic complet)" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                </CheckBox.Content>
                            </CheckBox>
                            
                            <!-- Section Defender - Affichée seulement si surveillance activée -->
                            <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="6" Padding="12,10"
                                    Visibility="{Binding EnableHardwareMonitoring, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="🛡️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Exception Windows Defender" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="3" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="Optionnel" FontSize="9" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10">
                                        Windows Defender peut parfois signaler LibreHardwareMonitor car il accède à des informations système bas niveau.
                                        <LineBreak/>Ajouter une exception permet d'éviter les ralentissements et faux positifs.
                                        <LineBreak/><Run FontStyle="Italic">Cette action est sécuritaire et réversible depuis les paramètres Windows.</Run>
                                    </TextBlock>
                                    
                                    <Button Style="{StaticResource FuturisticButton}"
                                            Command="{Binding ApplyDefenderExclusionCommand}"
                                            HorizontalAlignment="Left"
                                            Padding="14,8"
                                            FontSize="11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✓" Margin="0,0,6,0"/>
                                            <TextBlock Text="Ajouter l'exception (recommandé)"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Tests réseau externes - Onboarding clair -->
                    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="🌐" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Test de débit Internet (Speed Test)" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12">
                                Cette fonctionnalité permet de mesurer votre vitesse de connexion Internet (download/upload).
                                <LineBreak/>Le test utilise des serveurs externes pour mesurer la bande passante réelle.
                            </TextBlock>
                            
                            <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Accès Internet requis" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Des données seront envoyées vers des serveurs de test" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AllowExternalNetworkTests, Mode=TwoWay}"
                                              VerticalAlignment="Center">
                                        <CheckBox.Content>
                                            <TextBlock Text="Activer" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </CheckBox.Content>
                                    </CheckBox>
                                </Grid>
                            </Border>
                            
                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="✓ Activé — Le bouton 'Tester' sera disponible sur la page de scan"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllowExternalNetworkTests}" Value="False">
                                                <Setter Property="Text" Value="✗ Désactivé — Le speed test ne sera pas disponible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="{Binding AdminRightsTitle}" FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{Binding AdminStatusLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border CornerRadius="4" Padding="8,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FF4A1515"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                    <Setter Property="Background" Value="#FF1E4620"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding AdminStatusText}"
                                               Foreground="{Binding AdminStatusForeground}"/>
                                </Border>
                            </StackPanel>
                            
                            <Button Content="{Binding RestartAdminButtonText}" 
                                    Style="{StaticResource FuturisticButton}"
                                    Command="{Binding RestartAsAdminCommand}"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                        </StackPanel>
                    </Border>
                    
                        <Button Content="{Binding SaveSettingsButtonText}" 
                                Style="{StaticResource FuturisticButton}"
                                Command="{Binding SaveSettingsCommand}"
                                IsEnabled="{Binding IsSettingsDirty}"
                                HorizontalAlignment="Right"
                                Margin="0,30,0,0"
                                Padding="30,12"
                                FontSize="16"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</Window>
