<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Semantic tokens -->
    <Color x:Key="Color.Background">#FF0B0F14</Color>
    <Color x:Key="Color.Surface">#FF111826</Color>
    <Color x:Key="Color.SurfaceElevated">#FF162235</Color>
    <Color x:Key="Color.TextPrimary">#FFEAF7FF</Color>
    <Color x:Key="Color.TextSecondary">#FF9DB7CA</Color>
    <Color x:Key="Color.Border">#FF2A3C52</Color>
    <Color x:Key="Color.Success">#FF40D89A</Color>
    <Color x:Key="Color.Warning">#FFE7B056</Color>
    <Color x:Key="Color.Danger">#FFFF4D4F</Color>
    <Color x:Key="Color.Info">#FF66CCFF</Color>
    <Color x:Key="Color.DataGridRowHover">#FF15273A</Color>

    <!-- Requested blue X-Ray palette -->
    <Color x:Key="Color.Primary">#FF00BFFF</Color>
    <Color x:Key="Color.Secondary">#FF1E90FF</Color>
    <Color x:Key="Color.Hover">#FF3399FF</Color>
    <Color x:Key="Color.Pressed">#FF007ACC</Color>
    <Color x:Key="Color.Glow">#FF66CCFF</Color>
    <Color x:Key="Color.BorderActive">#FF4FC3F7</Color>
    <Color x:Key="Color.DangerSurface">#FF0E1E31</Color>
    <Color x:Key="Color.HudPanelBackground">#1A00BFFF</Color>
    <Color x:Key="Color.HudPanelBorder">#5000BFFF</Color>
    <Color x:Key="Color.HudPanelInnerBackground">#1400BFFF</Color>
    <Color x:Key="Color.HudPanelInnerBorder">#2800BFFF</Color>

    <Color x:Key="Color.Accent">#FF00BFFF</Color>
    <Color x:Key="Color.SectionHeaderBaseStart">#FF132033</Color>
    <Color x:Key="Color.SectionHeaderBaseEnd">#FF15283D</Color>
    <Color x:Key="Color.SectionHeaderHoverStart">#FF16324C</Color>
    <Color x:Key="Color.SectionHeaderHoverEnd">#FF1A3A58</Color>
    <Color x:Key="Color.SectionHeaderExpandedStart">#FF1A3A58</Color>
    <Color x:Key="Color.SectionHeaderExpandedEnd">#FF1D4467</Color>
    <Color x:Key="Color.SectionHeaderBorderBase">#50547A95</Color>
    <Color x:Key="Color.SectionHeaderBorderHover">#A04FC3F7</Color>
    <Color x:Key="Color.SectionHeaderBorderExpanded">#C04FC3F7</Color>

    <Color x:Key="Color.ScanSweepStart">#30007ACC</Color>
    <Color x:Key="Color.ScanSweepEnd">#B000BFFF</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.DataGridRowHover" Color="{StaticResource Color.DataGridRowHover}"/>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}"/>
    <SolidColorBrush x:Key="Brush.Glow" Color="{StaticResource Color.Glow}"/>
    <SolidColorBrush x:Key="Brush.BorderActive" Color="{StaticResource Color.BorderActive}"/>
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="{StaticResource Color.DangerSurface}"/>

    <LinearGradientBrush x:Key="Brush.ScanSweep" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource Color.ScanSweepStart}"/>
        <GradientStop Offset="1" Color="{StaticResource Color.ScanSweepEnd}"/>
    </LinearGradientBrush>

    <sys:Double x:Key="Radius.Card">12</sys:Double>
    <sys:Double x:Key="Spacing.S">8</sys:Double>
    <sys:Double x:Key="Spacing.M">12</sys:Double>
    <sys:Double x:Key="Spacing.L">16</sys:Double>
    <FontFamily x:Key="Font.Title">Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas</FontFamily>

    <DropShadowEffect x:Key="Shadow.Card" Color="#FF1ABCF0" BlurRadius="18" ShadowDepth="0" Opacity="0.22"/>

    <!-- New semantic aliases requested -->
    <Color x:Key="AccentHover">#FF3399FF</Color>
    <Color x:Key="AccentPressed">#FF007ACC</Color>
    <Color x:Key="AccentGlow">#FF66CCFF</Color>
    <Color x:Key="BorderActive">#FF4FC3F7</Color>
    <Color x:Key="DangerSurface">#FF0E1E31</Color>
    <Color x:Key="HudPanelBackground">#1A00BFFF</Color>
    <Color x:Key="HudPanelBorder">#5000BFFF</Color>
    <Color x:Key="HudPanelInnerBackground">#1400BFFF</Color>
    <Color x:Key="HudPanelInnerBorder">#2800BFFF</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource Color.Glow}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Color.Hover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource Color.Pressed}"/>
    <SolidColorBrush x:Key="BorderActiveBrush" Color="{StaticResource Color.BorderActive}"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource Color.DangerSurface}"/>
    <SolidColorBrush x:Key="HudPanelBackgroundBrush" Color="{StaticResource Color.HudPanelBackground}"/>
    <SolidColorBrush x:Key="HudPanelBorderBrush" Color="{StaticResource Color.HudPanelBorder}"/>
    <SolidColorBrush x:Key="HudPanelInnerBackgroundBrush" Color="{StaticResource Color.HudPanelInnerBackground}"/>
    <SolidColorBrush x:Key="HudPanelInnerBorderBrush" Color="{StaticResource Color.HudPanelInnerBorder}"/>

    <!-- Legacy keys kept for compatibility with existing styles -->
    <Color x:Key="BackgroundDark">#FF0B0F14</Color>
    <Color x:Key="BackgroundMedium">#FF111826</Color>
    <Color x:Key="BackgroundLight">#FF162235</Color>
    <Color x:Key="AccentRed">#FF00BFFF</Color>
    <Color x:Key="AccentRedDark">#FF007ACC</Color>
    <Color x:Key="AccentGreen">#FF40D89A</Color>
    <Color x:Key="AccentYellow">#FFE7B056</Color>
    <Color x:Key="AccentBlue">#FF1E90FF</Color>
    <Color x:Key="TextPrimary">#FFEAF7FF</Color>
    <Color x:Key="TextSecondary">#FF9DB7CA</Color>
    <Color x:Key="BorderColor">#FF2A3C52</Color>
    <Color x:Key="DataGridRowHover">#FF15273A</Color>

    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDark}"/>
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{StaticResource BackgroundMedium}"/>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLight}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="AccentRedDarkBrush" Color="{StaticResource AccentRedDark}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellow}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="{StaticResource DataGridRowHover}"/>

    <DropShadowEffect x:Key="RedGlow" Color="{StaticResource AccentGlow}" BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
    <DropShadowEffect x:Key="RedGlowStrong" Color="{StaticResource AccentGlow}" BlurRadius="34" ShadowDepth="0" Opacity="0.6"/>
    <DropShadowEffect x:Key="GreenGlow" Color="{StaticResource AccentGreen}" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
    <DropShadowEffect x:Key="SubtleShadow" Color="#FF06111F" BlurRadius="14" ShadowDepth="2" Opacity="0.42"/>

    <SolidColorBrush x:Key="ExpandableBoxBorderBrush" Color="#604FC3F7"/>
    <SolidColorBrush x:Key="ExpandableBoxHoverBrush" Color="#1A4FC3F7"/>
    <SolidColorBrush x:Key="ExpandableBoxActiveBrush" Color="#2A4FC3F7"/>
    <SolidColorBrush x:Key="ExpandableBoxActiveBorderBrush" Color="#FF4FC3F7"/>

    <!-- Scrollbar thumb colours — override DarkFuturiste red with X-Ray blue -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush"      Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource Color.Hover}"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragBrush"  Color="{StaticResource Color.Pressed}"/>
</ResourceDictionary>
