<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Semantic tokens -->
    <Color x:Key="Color.Background">#FF0D1117</Color>
    <Color x:Key="Color.Surface">#FF161B22</Color>
    <Color x:Key="Color.SurfaceElevated">#FF21262D</Color>
    <Color x:Key="Color.Accent">#FFFF4757</Color>
    <Color x:Key="Color.TextPrimary">#FFE6EDF3</Color>
    <Color x:Key="Color.TextSecondary">#FF8B949E</Color>
    <Color x:Key="Color.Border">#FF30363D</Color>
    <Color x:Key="Color.Success">#FF2ED573</Color>
    <Color x:Key="Color.Warning">#FFFFA502</Color>
    <Color x:Key="Color.Danger">#FFFF4757</Color>
    <Color x:Key="Color.Info">#FF3742FA</Color>
    <Color x:Key="Color.DataGridRowHover">#FF2D333B</Color>

    <Color x:Key="Color.Primary">#FFFF4757</Color>
    <Color x:Key="Color.Secondary">#FFFF6B78</Color>
    <Color x:Key="Color.Hover">#FFFF7A85</Color>
    <Color x:Key="Color.Pressed">#FFCC3A47</Color>
    <Color x:Key="Color.Glow">#FFFF8A95</Color>
    <Color x:Key="Color.BorderActive">#FFB4545E</Color>
    <Color x:Key="Color.DangerSurface">#FF4A1515</Color>
    <Color x:Key="Color.HudPanelBackground">#18FF4757</Color>
    <Color x:Key="Color.HudPanelBorder">#40FF4757</Color>
    <Color x:Key="Color.HudPanelInnerBackground">#10FF4757</Color>
    <Color x:Key="Color.HudPanelInnerBorder">#20FF4757</Color>

    <Color x:Key="Color.SectionHeaderBaseStart">#FF18222F</Color>
    <Color x:Key="Color.SectionHeaderBaseEnd">#FF1C2838</Color>
    <Color x:Key="Color.SectionHeaderHoverStart">#FF222C3A</Color>
    <Color x:Key="Color.SectionHeaderHoverEnd">#FF253244</Color>
    <Color x:Key="Color.SectionHeaderExpandedStart">#FF273140</Color>
    <Color x:Key="Color.SectionHeaderExpandedEnd">#FF2B394B</Color>
    <Color x:Key="Color.SectionHeaderBorderBase">#33586A7A</Color>
    <Color x:Key="Color.SectionHeaderBorderHover">#66D56A74</Color>
    <Color x:Key="Color.SectionHeaderBorderExpanded">#88D56A74</Color>

    <Color x:Key="Color.ScanSweepStart">#2AC15A64</Color>
    <Color x:Key="Color.ScanSweepEnd">#66D9757E</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.DataGridRowHover" Color="{StaticResource Color.DataGridRowHover}"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}"/>
    <SolidColorBrush x:Key="Brush.Glow" Color="{StaticResource Color.Glow}"/>
    <SolidColorBrush x:Key="Brush.BorderActive" Color="{StaticResource Color.BorderActive}"/>
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="{StaticResource Color.DangerSurface}"/>

    <LinearGradientBrush x:Key="Brush.ScanSweep" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource Color.ScanSweepStart}"/>
        <GradientStop Offset="1" Color="{StaticResource Color.ScanSweepEnd}"/>
    </LinearGradientBrush>

    <sys:Double x:Key="Radius.Card">12</sys:Double>
    <sys:Double x:Key="Spacing.S">8</sys:Double>
    <sys:Double x:Key="Spacing.M">12</sys:Double>
    <sys:Double x:Key="Spacing.L">16</sys:Double>
    <FontFamily x:Key="Font.Title">Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas</FontFamily>

    <DropShadowEffect x:Key="Shadow.Card" Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>

    <!-- New semantic aliases kept stable across themes -->
    <Color x:Key="AccentHover">#FFDB707A</Color>
    <Color x:Key="AccentPressed">#FFB64A56</Color>
    <Color x:Key="AccentGlow">#FFFF8A95</Color>
    <Color x:Key="BorderActive">#FFB4545E</Color>
    <Color x:Key="DangerSurface">#FF4A1515</Color>
    <Color x:Key="HudPanelBackground">#18FF4757</Color>
    <Color x:Key="HudPanelBorder">#40FF4757</Color>
    <Color x:Key="HudPanelInnerBackground">#10FF4757</Color>
    <Color x:Key="HudPanelInnerBorder">#20FF4757</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource Color.Glow}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Color.Hover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource Color.Pressed}"/>
    <SolidColorBrush x:Key="BorderActiveBrush" Color="{StaticResource Color.BorderActive}"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource Color.DangerSurface}"/>
    <SolidColorBrush x:Key="HudPanelBackgroundBrush" Color="{StaticResource Color.HudPanelBackground}"/>
    <SolidColorBrush x:Key="HudPanelBorderBrush" Color="{StaticResource Color.HudPanelBorder}"/>
    <SolidColorBrush x:Key="HudPanelInnerBackgroundBrush" Color="{StaticResource Color.HudPanelInnerBackground}"/>
    <SolidColorBrush x:Key="HudPanelInnerBorderBrush" Color="{StaticResource Color.HudPanelInnerBorder}"/>

    <!-- Scrollbar thumb colours — used by FuturisticStyles.xaml via DynamicResource -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush"      Color="#CCB84E58"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#E0C7626D"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragBrush"  Color="#F0D2707A"/>

    <!-- Legacy keys kept for compatibility with current styles -->
    <Color x:Key="BackgroundDark">#FF0D1117</Color>
    <Color x:Key="BackgroundMedium">#FF161B22</Color>
    <Color x:Key="BackgroundLight">#FF21262D</Color>
    <Color x:Key="AccentRed">#FFFF4757</Color>
    <Color x:Key="AccentRedDark">#FFCC3A47</Color>
    <Color x:Key="AccentGreen">#FF2ED573</Color>
    <Color x:Key="AccentYellow">#FFFFA502</Color>
    <Color x:Key="AccentBlue">#FF3742FA</Color>
    <Color x:Key="TextPrimary">#FFE6EDF3</Color>
    <Color x:Key="TextSecondary">#FF8B949E</Color>
    <Color x:Key="BorderColor">#FF30363D</Color>
    <Color x:Key="DataGridRowHover">#FF2D333B</Color>

    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDark}"/>
    <SolidColorBrush x:Key="BackgroundMediumBrush" Color="{StaticResource BackgroundMedium}"/>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLight}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="AccentRedDarkBrush" Color="{StaticResource AccentRedDark}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellow}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="{StaticResource DataGridRowHover}"/>

    <DropShadowEffect x:Key="RedGlow" Color="{DynamicResource AccentGlow}" BlurRadius="28" ShadowDepth="0" Opacity="0.58"/>
    <DropShadowEffect x:Key="RedGlowStrong" Color="{DynamicResource AccentGlow}" BlurRadius="42" ShadowDepth="0" Opacity="0.76"/>
    <DropShadowEffect x:Key="GreenGlow" Color="{StaticResource AccentGreen}" BlurRadius="18" ShadowDepth="0" Opacity="0.32"/>
    <DropShadowEffect x:Key="SubtleShadow" Color="Black" BlurRadius="8" ShadowDepth="1.5" Opacity="0.35"/>

    <SolidColorBrush x:Key="ExpandableBoxBorderBrush" Color="#44B4545E"/>
    <SolidColorBrush x:Key="ExpandableBoxHoverBrush" Color="#18B4545E"/>
    <SolidColorBrush x:Key="ExpandableBoxActiveBrush" Color="#24B4545E"/>
    <SolidColorBrush x:Key="ExpandableBoxActiveBorderBrush" Color="#CC646E"/>
</ResourceDictionary>
