<UserControl x:Class="PCDiagnosticPro.Controls.ThemedSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="18"
             d:DesignWidth="18"
             Width="18"
             Height="18"
             IsHitTestVisible="False">

    <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Width}"
          Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Height}">
        <Path Stroke="{DynamicResource Brush.Accent}"
              StrokeThickness="2.2"
              StrokeDashArray="0.28 0.72"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Data="M9,1 A8,8 0 1 1 8.99,1"
              Opacity="0.95"
              Stretch="Fill"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform x:Name="SpinnerRotateTransform" />
            </Path.RenderTransform>
        </Path>
    </Grid>
</UserControl>
