<Window x:Class="PCDiagnosticPro.Views.CyberpunkInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PCDiagnosticPro.Models"
        Height="420" Width="520"
        MinHeight="320" MinWidth="400"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#060A12">

    <Window.Resources>
        <SolidColorBrush x:Key="CyberBg" Color="#060A12"/>
        <SolidColorBrush x:Key="CyberCardBg" Color="#0B1220"/>
        <SolidColorBrush x:Key="CyberBorder" Color="#2AA7FF"/>
        <SolidColorBrush x:Key="CyberText" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="CyberWarning" Color="#FFD88A"/>
        <SolidColorBrush x:Key="CyberDanger" Color="{DynamicResource Color.Danger}"/>
        <SolidColorBrush x:Key="CyberAction" Color="#9FD1FF"/>
        <SolidColorBrush x:Key="CyberRed" Color="{DynamicResource AccentRed}"/>
        <DropShadowEffect x:Key="CyberRedGlow" Color="{DynamicResource AccentGlow}" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
        <DropShadowEffect x:Key="CyberShadow" Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>

        <Style x:Key="InfoLineTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CyberText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:InfoTone.Warning}">
                    <Setter Property="Foreground" Value="{StaticResource CyberWarning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:InfoTone.Danger}">
                    <Setter Property="Foreground" Value="{StaticResource CyberDanger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:InfoTone.Action}">
                    <Setter Property="Foreground" Value="{StaticResource CyberAction}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleBlock" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource CyberText}"
                   Margin="0,0,0,12" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <Border Background="{StaticResource CyberCardBg}" BorderBrush="{StaticResource CyberBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Effect="{StaticResource CyberShadow}">
                <StackPanel>
                    <ItemsControl x:Name="ContentLinesControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource InfoLineTextStyle}">
                                        <Run Text="{Binding Emoji}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Prefix, Mode=OneWay}"/>
                                        <Run Text="{Binding Text}"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="SmartTemperatureRangesPanel"
                            Visibility="Collapsed"
                            Margin="0,8,0,0"
                            Padding="10"
                            CornerRadius="6"
                            BorderBrush="#255A84"
                            BorderThickness="1"
                            Background="#0A1526">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Plage température SMART" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CyberText}" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Degrés (°C)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CyberText}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Normal" Foreground="#5EE280" Margin="0,4,10,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="&lt; 50" Foreground="{StaticResource CyberText}" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Prudence" Foreground="{StaticResource CyberWarning}" Margin="0,4,10,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="50 à 60" Foreground="{StaticResource CyberText}" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Dangereux" Foreground="{StaticResource CyberDanger}" Margin="0,4,10,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="&gt; 60" Foreground="{StaticResource CyberText}" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Fermer" HorizontalAlignment="Right" Padding="24,10" FontSize="14" FontWeight="SemiBold"
                Background="{StaticResource CyberCardBg}" Foreground="{StaticResource CyberText}"
                BorderBrush="{StaticResource CyberBorder}" BorderThickness="1" Cursor="Hand"
                Click="Close_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource CyberRed}"/>
                                        <Setter TargetName="border" Property="Effect" Value="{StaticResource CyberRedGlow}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
