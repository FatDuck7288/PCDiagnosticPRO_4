<Window x:Class="PCDiagnosticPro.Views.KernelPowerInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Événements Kernel Power"
        Height="580" Width="660"
        MinHeight="440" MinWidth="500"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#060A12">

    <Window.Resources>
        <SolidColorBrush x:Key="CyberBg" Color="#060A12"/>
        <SolidColorBrush x:Key="CyberCardBg" Color="#0B1220"/>
        <SolidColorBrush x:Key="CyberBorder" Color="#2AA7FF"/>
        <SolidColorBrush x:Key="CyberText" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="CyberTextDim" Color="#8B949E"/>
        <SolidColorBrush x:Key="CyberRed" Color="{DynamicResource AccentRed}"/>
        <SolidColorBrush x:Key="CyberGreen" Color="#3FB950"/>
        <DropShadowEffect x:Key="CyberRedGlow" Color="{DynamicResource AccentGlow}" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
        <DropShadowEffect x:Key="CyberShadow" Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Événements Kernel Power — 30 derniers jours"
                   FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource CyberText}"
                   Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <StackPanel>

                <!-- Count badges: KP1 and KP41 -->
                <Border Background="{StaticResource CyberCardBg}" BorderBrush="{StaticResource CyberBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12"
                        Effect="{StaticResource CyberShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- KP ID 1 -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="ID 1 — Informationnel" FontSize="11"
                                       Foreground="{StaticResource CyberTextDim}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <Border CornerRadius="20" Background="#0D1E2E"
                                    BorderBrush="{StaticResource CyberBorder}" BorderThickness="1"
                                    Padding="20,4" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Kp1Count30d}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource CyberBorder}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <!-- KP ID 41 -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="ID 41 — Critique (crash)" FontSize="11"
                                       Foreground="{StaticResource CyberTextDim}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <Border CornerRadius="20" Background="{DynamicResource DangerSurfaceBrush}"
                                    BorderBrush="{StaticResource CyberRed}" BorderThickness="1"
                                    Padding="20,4" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Kp41Count30d}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource CyberRed}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Events DataGrid -->
                <Border Background="{StaticResource CyberCardBg}" BorderBrush="{StaticResource CyberBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="0,0,0,8" Margin="0,0,0,12"
                        Effect="{StaticResource CyberShadow}">
                    <StackPanel>
                        <TextBlock Text="Historique des événements" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberBorder}" Margin="12,10,12,6"/>
                        <DataGrid ItemsSource="{Binding Events}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  MaxHeight="200"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource CyberCardBg}"
                                  RowBackground="#0B1220"
                                  AlternatingRowBackground="#0F172A"
                                  Foreground="{StaticResource CyberText}"
                                  BorderThickness="0"
                                  HorizontalGridLinesBrush="#1A2A40"
                                  VerticalGridLinesBrush="Transparent"
                                  FontSize="12"
                                  SelectionMode="Single">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0B1220"/>
                                    <Setter Property="Foreground" Value="{StaticResource CyberTextDim}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="#1A2A40"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{StaticResource CyberText}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1A2A40"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="130"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding EventId}" Width="40"/>
                                <DataGridTextColumn Header="Sévérité" Binding="{Binding Severity}" Width="90"/>
                                <DataGridTextColumn Header="Détails" Binding="{Binding Details}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Action suggestion -->
                <Border Background="#0A1A0A" BorderBrush="{StaticResource CyberGreen}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                        Effect="{StaticResource CyberShadow}">
                    <StackPanel>
                        <TextBlock Text="Recommandation" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberGreen}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ActionSuggestion}" Foreground="{StaticResource CyberText}"
                                   FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <!-- Reference explanation -->
                <Border Background="{StaticResource CyberCardBg}" BorderBrush="{StaticResource CyberBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,0"
                        Effect="{StaticResource CyberShadow}">
                    <StackPanel>
                        <TextBlock Text="Référence" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource CyberBorder}" Margin="0,0,0,8"/>
                        <TextBlock Foreground="{StaticResource CyberText}" FontSize="12" TextWrapping="Wrap" LineHeight="20">
                            <Run Text="• ID 1 — Information : changement d'état lié à l'alimentation (veille, sortie de veille, secteur/batterie, plan d'alimentation). Bénin."/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource CyberText}" FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0">
                            <Run Text="• ID 41 — Critique : le système a redémarré sans arrêt normal préalable (crash, coupure de courant, BSOD). À investiguer si récurrent."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Fermer button with red glow on hover -->
        <Button Grid.Row="2" Content="Fermer" HorizontalAlignment="Right" Padding="24,10" FontSize="14" FontWeight="SemiBold"
                Background="{StaticResource CyberCardBg}" Foreground="{StaticResource CyberText}"
                BorderBrush="{StaticResource CyberBorder}" BorderThickness="1" Cursor="Hand"
                Click="Close_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource CyberRed}"/>
                                        <Setter TargetName="border" Property="Effect" Value="{StaticResource CyberRedGlow}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
