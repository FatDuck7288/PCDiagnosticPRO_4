<Window x:Class="PCDiagnosticPro.Views.AddApiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add API"
        Height="540"
        Width="560"
        MinHeight="500"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDarkBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="API provider configuration"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="This profile is used by chat and AutoFix agents when API mode is enabled. Enter provider, API key, and model."
                       Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" Margin="0,0,10,10" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="ProviderCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Height="32"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key" Margin="0,0,10,10" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Height="32"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Model name" Margin="0,0,10,10" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox x:Name="ModelNameTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Height="32"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Advanced URL" Margin="0,0,10,10" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <CheckBox x:Name="AdvancedUrlCheckBox"
                          Grid.Row="3"
                          Grid.Column="1"
                          Margin="0,4,0,10"
                          Content="Set custom base URL"
                          Checked="AdvancedUrlCheckBox_Changed"
                          Unchecked="AdvancedUrlCheckBox_Changed"/>

                <TextBlock x:Name="BaseUrlLabel" Grid.Row="4" Grid.Column="0" Text="Base URL" Margin="0,0,10,10" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBox x:Name="BaseUrlTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Height="32"/>

                <TextBlock x:Name="UrlRuleTextBlock"
                           Grid.Row="5"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Margin="0,0,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ErrorTextBlock"
                       Grid.Column="0"
                       Foreground="{DynamicResource AccentRedBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <Button Grid.Column="1"
                    Content="Test connection"
                    Margin="0,0,10,0"
                    Padding="14,8"
                    Click="TestButton_Click"/>

            <Button Grid.Column="2"
                    Content="Cancel"
                    Margin="0,0,10,0"
                    Padding="14,8"
                    Click="CancelButton_Click"/>

            <Button Grid.Column="3"
                    Content="Save"
                    Padding="14,8"
                    Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
