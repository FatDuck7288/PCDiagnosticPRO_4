<Window x:Class="PCDiagnosticPro.Views.AppsDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PCDiagnosticPro.Converters"
        xmlns:ctrl="clr-namespace:PCDiagnosticPro.Controls"
        mc:Ignorable="d"
        Title="Applications installées" 
        Height="600" Width="900"
        MinHeight="400" MinWidth="600"
        Background="{StaticResource BackgroundDarkBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="📦 Applications installées" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding SummaryText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Summary Stats + Search (PARTIE 9) -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundMediumBrush}" 
                CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Stats Row + Update -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="4" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total: " Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding TotalCount}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2ED573" CornerRadius="4" Padding="12,6" Margin="0,0,10,0"
                                Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Récentes (30j): " Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding RecentCount}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#9B59B6" CornerRadius="4" Padding="12,6" Margin="0,0,10,0"
                                Visibility="{Binding HasStartupApps, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Au démarrage: " Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding StartupCount}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#FF7F50"
                                CornerRadius="4"
                                Padding="12,6"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasUpdatableApps, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MAJ dispo: " Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding UpdatableCount}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding UpdateCheckStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding UpdateCheckStatusText}"
                                   Margin="0,0,12,0"/>

                        <ctrl:ThemedSpinner Grid.Column="2"
                                            Width="18"
                                            Height="18"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"
                                            IsActive="{Binding IsCheckingUpdates}"
                                            Visibility="{Binding IsCheckingUpdates, Converter={StaticResource BoolToVisibility}}"/>

                        <Button Grid.Column="3"
                                Content="{Binding CheckUpdatesButtonLabel}"
                                Click="CheckUpdatesButton_Click"
                                IsEnabled="{Binding CanRunUpdateCheck}"
                                Height="32"
                                MinWidth="170"
                                Padding="14,6"
                                Background="{StaticResource AccentBlueBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"/>
                    </Grid>
                </Grid>
                
                <!-- Search Row -->
                <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,10,0,0"
                         Background="{StaticResource BackgroundLightBrush}" 
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         Padding="8,6" VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Tag" Value="🔍 Rechercher une application..."/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredApplications}" 
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="{StaticResource BackgroundMediumBrush}"
                  RowBackground="{StaticResource BackgroundMediumBrush}"
                  AlternatingRowBackground="{StaticResource BackgroundLightBrush}"
                  BorderThickness="1"
                  BorderBrush="{StaticResource BorderBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Sélection" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelectedForUninstall, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanUninstall}"
                                      ToolTip="Cocher pour désinstaller"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Éditeur" Binding="{Binding PublisherDisplay}" Width="170"/>
                <DataGridTextColumn Header="Version" Binding="{Binding VersionDisplay}" Width="120"/>
                <DataGridTextColumn Header="Statut MAJ" Binding="{Binding UpdateStatus}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Note: Base recommandee pour les mises a jour applicatives: winget (catalogue communautaire Microsoft) + Microsoft Store. Le bouton Mise A Jour applique winget upgrade --all."
                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="{Binding UninstallButtonLabel}"
                        IsEnabled="{Binding HasSelectedForUninstall}"
                        Click="UninstallButton_Click"
                        Height="36"
                        MinWidth="150"
                        Padding="16,8"
                        Margin="15,0,0,0"
                        Background="{DynamicResource ButtonPrimaryBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>
                <Button Grid.Column="2" Content="Fermer"
                        Style="{StaticResource FuturisticButton}"
                        Click="CloseButton_Click"
                        Padding="20,10" Margin="15,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
