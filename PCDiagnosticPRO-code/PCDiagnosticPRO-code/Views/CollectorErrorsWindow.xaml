<Window x:Class="PCDiagnosticPro.Views.CollectorErrorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Détails de collecte"
        Height="620" Width="860"
        MinHeight="420" MinWidth="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#FF0D1117">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFE6EDF3"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF8B949E"/>
        <SolidColorBrush x:Key="AccentRedBrush" Color="{DynamicResource AccentRed}"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#FFFFA502"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF4DA3FF"/>
        <SolidColorBrush x:Key="BgMedium" Color="#FF161B22"/>
        <SolidColorBrush x:Key="BorderDark" Color="#FF30363D"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Détails de collecte" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="10" Background="#111A27" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
                    <TextBlock Text="Résumé lisible : les détails techniques sont masqués par défaut pour éviter les informations brutes."
                               Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="{Binding ErrorHeader}" FontSize="11" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="{StaticResource AccentRedBrush}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding ErrorItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgMedium}" CornerRadius="6" Padding="10,8"
                                    Margin="0,0,0,6" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Section}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{StaticResource AccentBlue}" Margin="10,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ConfidenceImpact}" Foreground="{StaticResource AccentYellow}" Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Reason}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,3,0,0"
                                               Visibility="{Binding HasTimestamp, Converter={StaticResource BoolToVisibility}}"/>
                                    <Expander Header="Détails techniques" Margin="0,4,0,0"
                                              Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding TechnicalDetails}" Foreground="{StaticResource TextSecondary}"
                                                   FontSize="10" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,4,0,0"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding MissingHeader}" FontSize="11" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="{StaticResource AccentYellow}" Margin="0,10,0,6"/>
                <ItemsControl ItemsSource="{Binding MissingItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgMedium}" CornerRadius="6" Padding="10,8"
                                    Margin="0,0,0,6" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Section}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{StaticResource AccentBlue}" Margin="10,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ConfidenceImpact}" Foreground="{StaticResource AccentYellow}" Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Reason}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,3,0,0"
                                               Visibility="{Binding HasTimestamp, Converter={StaticResource BoolToVisibility}}"/>
                                    <Expander Header="Détails techniques" Margin="0,4,0,0"
                                              Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding TechnicalDetails}" Foreground="{StaticResource TextSecondary}"
                                                   FontSize="10" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,4,0,0"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding CsharpHeader}" FontSize="11" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="{StaticResource AccentBlue}" Margin="0,10,0,6"/>
                <ItemsControl ItemsSource="{Binding CsharpItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgMedium}" CornerRadius="6" Padding="10,8"
                                    Margin="0,0,0,6" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Section}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{StaticResource AccentBlue}" Margin="10,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ConfidenceImpact}" Foreground="{StaticResource AccentYellow}" Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Reason}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,3,0,0"
                                               Visibility="{Binding HasTimestamp, Converter={StaticResource BoolToVisibility}}"/>
                                    <Expander Header="Détails techniques" Margin="0,4,0,0"
                                              Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding TechnicalDetails}" Foreground="{StaticResource TextSecondary}"
                                                   FontSize="10" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,4,0,0"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Fermer" Width="120" Height="34" Margin="0,12,0,0"
                HorizontalAlignment="Right" Cursor="Hand"
                Background="{StaticResource AccentRedBrush}" Foreground="White"
                BorderThickness="0" FontWeight="SemiBold"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
