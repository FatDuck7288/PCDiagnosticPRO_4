<Window x:Class="PCDiagnosticPro.Views.RestorePointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Points de restauration"
        Height="520" Width="760"
        MinHeight="420" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#FF0D1117">

    <Window.Resources>
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Foreground" Value="#FFE6EDF3"/>
            <Setter Property="Background" Value="#FF1F2937"/>
            <Setter Property="BorderBrush" Value="#FF30363D"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Points de restauration" FontSize="20" FontWeight="Bold" Foreground="#FFE6EDF3" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#FF161B22" BorderBrush="#FF30363D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding CountLine}" Foreground="#FFE6EDF3" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusLine}" Foreground="#FF8B949E" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ConfidenceLine}" Foreground="#FF8B949E" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding LatestPointLine}" Foreground="#FF8B949E" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ListView Grid.Row="2" ItemsSource="{Binding Details.Points}" Background="#FF161B22" BorderBrush="#FF30363D" BorderThickness="1" Foreground="#FFE6EDF3">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="70" DisplayMemberBinding="{Binding DisplaySequence}"/>
                    <GridViewColumn Header="Date" Width="180" DisplayMemberBinding="{Binding DisplayDate}"/>
                    <GridViewColumn Header="Description" Width="460" DisplayMemberBinding="{Binding Description}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ActionMessage}" Foreground="#FFFFA502" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>

            <Button Grid.Column="1" x:Name="CreateButton" Content="Créer un point de restauration" Width="220" Height="34" Margin="0,0,10,0"
                    Click="CreateRestorePoint_Click" IsEnabled="{Binding CanCreate}"
                    Background="#FF1E5A8A" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>

            <Button Grid.Column="2" Content="Fermer" Width="110" Height="34" Click="Close_Click"
                    Background="{DynamicResource AccentRedBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
