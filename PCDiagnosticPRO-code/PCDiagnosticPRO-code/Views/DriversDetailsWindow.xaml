<Window x:Class="PCDiagnosticPro.Views.DriversDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PCDiagnosticPro.Converters"
        xmlns:ctrl="clr-namespace:PCDiagnosticPro.Controls"
        mc:Ignorable="d"
        Title="Détails des pilotes" 
        Height="600" Width="1000"
        MinHeight="400" MinWidth="700"
        Background="{StaticResource BackgroundDarkBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🔧 Inventaire des pilotes" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding SummaryText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Summary Stats + Search/Filter (PARTIE 8) -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundMediumBrush}" 
                CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Stats Row + Update Action -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="4" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total: " Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding TotalCount}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#2ED573" CornerRadius="4" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Signés: " Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding SignedCount}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFA502" CornerRadius="4" Padding="12,6" Margin="0,0,10,0"
                                Visibility="{Binding HasUnsigned, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Non signés: " Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding UnsignedCount}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource DangerBrush}" CornerRadius="4" Padding="12,6" Margin="0,0,10,0"
                                Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Erreurs: " Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding ProblemCount}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#9B59B6" CornerRadius="4" Padding="12,6" Margin="0,0,10,0"
                                Visibility="{Binding HasOldAge, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Anciens (age): " Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding OldAgeCount}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FF7F50" CornerRadius="4" Padding="12,6" Margin="0,0,10,0"
                                Visibility="{Binding HasUpdatesFound, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mises a jour trouvees: " Foreground="White" FontSize="12"/>
                                <TextBlock Text="{Binding UpdatesFoundCount}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Tout cocher MAJ trouvees"
                                Click="SelectAllOutdatedButton_Click"
                                Height="34"
                                MinWidth="170"
                                Margin="0,0,10,0"
                                Padding="14,6"
                                Background="{StaticResource AccentBlueBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"/>

                        <Button Grid.Column="1"
                                Content="Tout decocher"
                                Click="ClearSelectionButton_Click"
                                Height="34"
                                MinWidth="130"
                                Margin="10,0,0,0"
                                Padding="14,6"
                                Background="{StaticResource BackgroundLightBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                FontWeight="SemiBold"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding UpdateRunStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding UpdateRunStatusText}"
                                   Margin="12,0,12,0"/>

                        <ctrl:ThemedSpinner Grid.Column="3"
                                            Width="18"
                                            Height="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0"
                                            IsActive="{Binding IsUpdatingDrivers}"
                                            Visibility="{Binding IsUpdatingDrivers, Converter={StaticResource BoolToVisibility}}"/>

                        <Button Grid.Column="4"
                                Content="{Binding UpdateButtonLabel}"
                                Click="UpdateDriversButton_Click"
                                IsEnabled="{Binding CanExecuteUpdate}"
                                Height="34"
                                MinWidth="170"
                                Margin="12,0,0,0"
                                Padding="18,6"
                                Background="{DynamicResource ButtonPrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"/>
                    </Grid>
                </Grid>
                
                <!-- Search/Filter Row -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{StaticResource BackgroundLightBrush}" 
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             Padding="8,6" VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Tag" Value="🔍 Rechercher un pilote..."/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Grid.Column="1" Text="Classe:" VerticalAlignment="Center" Margin="15,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding DeviceClasses}" 
                              SelectedItem="{Binding SelectedClass}" MinWidth="150"
                              Background="{StaticResource BackgroundLightBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredDrivers}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  Background="{StaticResource BackgroundMediumBrush}"
                  RowBackground="{StaticResource BackgroundMediumBrush}"
                  AlternatingRowBackground="{StaticResource BackgroundLightBrush}"
                  BorderThickness="1"
                  BorderBrush="{StaticResource BorderBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Classe" Binding="{Binding DeviceClass}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Périphérique" Binding="{Binding DeviceName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Fournisseur" Binding="{Binding Provider}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Version" Binding="{Binding DriverVersion}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DriverDateFormatted}" Width="90" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Signé" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SignedIcon}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Selection" Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelectedForUpdate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanSelectForUpdate}"
                                      ToolTip="Cochez les pilotes obsoletes ou avec mise a jour Windows Update detectee."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Mise a jour" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding UpdateAvailabilityDisplay}"
                                       ToolTip="{Binding UpdateAvailabilityTooltip}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Statut" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusColor}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="INF" Binding="{Binding InfName}" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="3" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="{Binding VerificationRuleNote}"
                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Fermer" 
                        Style="{StaticResource FuturisticButton}"
                        Click="CloseButton_Click"
                        Padding="20,10" Margin="15,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
