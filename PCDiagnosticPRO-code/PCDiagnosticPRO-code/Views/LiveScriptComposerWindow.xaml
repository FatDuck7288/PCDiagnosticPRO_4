<Window x:Class="PCDiagnosticPro.Views.LiveScriptComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Live Script Composer"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundDarkBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Live Script Composer"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="MetaTextBlock"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,10,0,10"
                Padding="8"
                CornerRadius="8"
                Background="#FF0D1828"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <ListView x:Name="TimelineListView"
                      Height="112"
                      Background="Transparent"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Agent" Width="190" DisplayMemberBinding="{Binding Agent}"/>
                        <GridViewColumn Header="Start" Width="180" DisplayMemberBinding="{Binding Start}"/>
                        <GridViewColumn Header="End" Width="180" DisplayMemberBinding="{Binding End}"/>
                        <GridViewColumn Header="Duration" Width="110" DisplayMemberBinding="{Binding Duration}"/>
                        <GridViewColumn Header="Status" Width="150" DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Coder output">
                <TextBox x:Name="CoderOutputTextBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#FF0D1320"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </TabItem>
            <TabItem Header="Reviewer diff">
                <TextBox x:Name="ReviewerDiffTextBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#FF0D1320"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </TabItem>
            <TabItem Header="Refiner diff">
                <TextBox x:Name="RefinerDiffTextBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#FF0D1320"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </TabItem>
            <TabItem Header="Final script">
                <TextBox x:Name="FinalScriptTextBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#FF0D1320"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Copier script final"
                    Margin="0,0,10,0"
                    Padding="12,7"
                    Click="CopyFinalScriptButton_Click"/>
            <Button Content="Ouvrir dossier logs"
                    Margin="0,0,10,0"
                    Padding="12,7"
                    Click="OpenLogsFolderButton_Click"/>
            <Button Content="Fermer"
                    Padding="12,7"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
